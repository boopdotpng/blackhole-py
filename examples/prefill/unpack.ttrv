// Untile 32-token panels before Qwen's row-major attention and recurrent kernels.
const N = 5120
const PANELS = 2
const BLOCK = 128
const STRIDE = (N + 1023) / 1024 * 1024
const WORKERS = 128
grid WORKERS
param x: bf16[]
param output: bf16[]
l1 tiles: bf16[BLOCK * 32]
l1 rows: bf16[BLOCK * 32]
shared { first, count = split(PANELS * (N / BLOCK)) }
fn brisc() {
    for task in first..first + count {
        panel = task / (N / BLOCK)
        block = task % (N / BLOCK)
        noc.read tiles, x[task * BLOCK * 32], n=BLOCK * 32, wait
        for r in 0..32 {
            for k in 0..BLOCK / 32 {
                src = tiles + k * 1024 + (r / 16) * 512 + (r % 16) * 16
                dstp = rows + r * BLOCK + k * 32
                l1.copy_words dstp, src, n=8
                l1.copy_words dstp + 16, src + 256, n=8
            }
        }
        wr = noc.group write
        for r in 0..32 {
            noc.write output[(panel * 32 + r) * STRIDE + block * BLOCK], rows + r * BLOCK, n=BLOCK, tid=wr
        }
        noc.wait wr
    }
}
