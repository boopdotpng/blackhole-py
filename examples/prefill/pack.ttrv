// Assemble the live prompt rows into the face layout of each activation tile.
const K = 7168
const STRIDE = ((K + 1023) / 1024) * 1024
const WORKERS = 32
const BLOCK = 128
const PANELS = 1
const TILE_ROWS = 16
const PAGE = TILE_ROWS * 32
grid WORKERS
param x: bf16[]
const FP8 = 0
if FP8 { type ACT = e4m3
    param quant: e4m3[]
    l1 table: e4m3[65536]
    l1 table_ready: u32[1], keep
} else { type ACT = bf16 }
param output: ACT[]
param rows: u32
l1 raw: bf16[BLOCK]
l1 tiles: ACT[(BLOCK / 32) * PAGE]
shared { first, count = split(PANELS * (K / BLOCK)) }
fn brisc() {
    if FP8 {
        // All blocks use the same quantization table. One reader feeds each worker column.
        if core.y == 0 {
            noc.read table, quant[0], n=65536, wait
            peers = WORKERS - core.id
            if peers > 10 { peers = 10 }
            if peers > 1 {
                for page in 0..4 {
                    addr = table + page * 16384
                    noc.mcast rect(core.x, 0, core.x, peers - 1, addr), addr, n=16384, wait
                }
                table_ready[0] = 1
                noc.mcast rect(core.x, 0, core.x, peers - 1, table_ready), table_ready, n=1, wait
            }
        } else {
            loop { if table_ready[0] { break }; fence }
        }
        table_ready[0] = 0
    }
    for task in first..first + count {
        panel = task / (K / BLOCK)
        block = task % (K / BLOCK)
        for r in 0..rows {
            noc.read raw, x[(panel * TILE_ROWS + r) * STRIDE + block * BLOCK], n=BLOCK, wait
            for k in 0..BLOCK / 32 {
                dest = tiles + k * PAGE + (r / 16) * 512 + (r % 16) * 16
                if FP8 {
                    repeat c in 0..16 {
                        dest[c] = table[bits_u32(raw[k * 32 + c])]
                        dest[256 + c] = table[bits_u32(raw[k * 32 + 16 + c])]
                    }
                } else {
                    l1.copy_words dest, raw + k * 32, n=8
                    l1.copy_words dest + 256, raw + k * 32 + 16, n=8
                }
            }
        }
        noc.write output[task * (BLOCK / 32) * PAGE], tiles, n=(BLOCK / 32) * PAGE, wait
    }
}
