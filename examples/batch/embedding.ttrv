// Batched embedding gather: row r of output = weights[token], where (pos, active, slot, token) is row r's 64-byte
// entry in the host step table (see attention.ttrv). The host samples each token, so it writes it into the table.
// Inactive rows are skipped.
const ROWS = 32
grid ROWS
const EMBED_TILES = 4
const DIM = 1024 * EMBED_TILES

param weights: bf16[]
param output: bf16[]          // [ROWS, DIM]
param table: u32[], host

l1 meta: u32[16]
l1 row: bf16[DIM]

fn brisc() {
    noc.read meta, table[core.id * 16], n=16, wait
    if meta[1] == 0 { return }
    noc.read row, weights[meta[3] * DIM], n=DIM, wait
    noc.write output[core.id * DIM], row, n=DIM, wait
}
