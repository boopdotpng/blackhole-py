// ../prefill/unpack.ttrv with the rows written to pinned host memory: panel tiles of the LM head's output columns
// col .. col + N - 1 become columns of row-major host logits [rows, STRIDE]. Only the first `rows` rows (the live
// ones) cross PCIe. Reading DRAM back over the host's DMA ran at under 1 GB/s; these posted writes do not wait on it.
const N = 5120
const PANELS = 2
const BLOCK = 128
const STRIDE = (N + 1023) / 1024 * 1024
const WORKERS = 128
grid WORKERS
param x: bf16[]
param output: bf16[], host
param col: u32
param rows: u32
l1 tiles: bf16[BLOCK * 32]
l1 lines: bf16[BLOCK * 32]
shared { first, count = split(PANELS * (N / BLOCK)) }
fn brisc() {
    for task in first..first + count {
        panel = task / (N / BLOCK)
        block = task % (N / BLOCK)
        live = rows - panel * 32
        if rows > panel * 32 {
            if live > 32 { live = 32 }
            noc.read tiles, x[task * BLOCK * 32], n=BLOCK * 32, wait
            for r in 0..live {
                for k in 0..BLOCK / 32 {
                    src = tiles + k * 1024 + (r / 16) * 512 + (r % 16) * 16
                    dstp = lines + r * BLOCK + k * 32
                    l1.copy_words dstp, src, n=8
                    l1.copy_words dstp + 16, src + 256, n=8
                }
            }
            wr = noc.group write
            for r in 0..live {
                noc.write output[(panel * 32 + r) * STRIDE + col + block * BLOCK], lines + r * BLOCK, n=BLOCK, tid=wr
            }
            noc.wait wr
        }
    }
}
