// Llama3 greedy sampling: token = argmax(logits), lowest token ID on ties.
// Port of blackhole-py-old/examples/llama3/kernels.py argmax and ttko/argmax.py.
//
// One source for 1B and 8B: the vocabulary (128256) and the BF16 logits are the same
// in both. The grid is 88 workers, as the old projection_cores. ASSUMPTION: the lm kernel
// writes logits as one dense row-major BF16 vector of VOCAB elements (the old lm
// wrote per-core compact tiles instead). Argmax therefore picks its own split.
//
// Per worker: BRISC reads its logits slice [first, first + count). As in the O
// projection, lo = first & ~31 starts a 64-byte line and logit first + i sits at
// datum lead + i of the page. TRISC0/1 copy the page into FP32 Dst; the SFPU turns
// each value into an order-preserving integer key and keeps a running maximum per
// lane, with index capture recording where each winner came from. That leaves 32
// (key, Dst index) candidates. Because the page is row-major and a Dst tile holds
// its 1024 datums in order, a Dst index is the datum index in the page: logit
// lo + index. BRISC picks the best candidate and sends it to worker 0, which
// picks the global winner, writes it to the host and appends it to the history.
//
// Params: buffers logits, history, tokens (host); integers start_pos (the position
// being processed; the token generated here belongs at start_pos + 1) and
// write_token (nonzero: append it to history). Queued by the host before each run.
//
// Ties: keys are nonnegative. sfp.minmax keeps the old maximum on equal
// nonnegative values, and each lane visits its datums in increasing index order
// (a = 0, 2, 4, ...: even columns, then odd, then the next four rows). So every
// lane keeps its first maximum. BRISC and worker 0 then prefer the lower token on
// equal keys / the lower worker (whose slice comes first).

grid 88

const VOCAB = 128256
const MAX_TOKENS = 8192
// Largest slice is ceil(VOCAB / grid.size) logits (1458 on 88), plus up to 31 lead datums.
const SPAN = 31 + (VOCAB + grid.size - 1) / grid.size
const TILES = (SPAN + 1023) / 1024    // 2; FP32 Dst holds at most 8 tiles

param logits: bf16[]                  // dense, VOCAB (written by llama3_lm.ttrv)
param history: u32[]                  // token ids by position, MAX_TOKENS
param tokens: u32[], host             // one 16-byte slot per position, MAX_TOKENS + 1 slots
param start_pos: u32
param write_token: u32                // 1: append the token to history (0 when write_pos == MAX_TOKENS)
// Tensor parallel: this card holds vocabulary rows [VOCAB_BASE, VOCAB_BASE + VOCAB). Worker 0 writes its
// (key, global token) to winner and a cross-card pick writes the token to the host and history.
const TP = 0
const VOCAB_BASE = 0
// A linked rank exchanges its local winner through the E1 mailbox, then publishes the global token.
const LINK_PICK = 0
const ETH_X = 0
const ETH_Y = 1
if LINK_PICK { param step: u32 }
if TP { param winner: u32[] }

shared {
    first, count = split(VOCAB)
    lo = first & ~31
    lead = first & 31
    write_pos = start_pos + 1         // where the generated token goes
}

cb page: bf16[TILES * 1024], pages=1   // this worker's logits at datum lead + i
// GAP: candidates are integer bit patterns. Pack has no integer format (§9) and
// scalar code can't do arithmetic on fp32 elements (§5), so the CB is declared
// u32 and packed as fp32 -> fp32. The spec needs a pack format, or a rule
// allowing that reinterpretation, that passes 32-bit integers through unchanged
// (no denormal flush: every index is a denormal FP32 bit pattern).
cb candidates: u32[64], pages=1        // 32 (key, Dst index) pairs, lane l at 2l, 2l+1

l1 local: u32[4]                       // this worker's (key, token); later the winner
l1 ack: u32[4]                         // atomic increment response
l1 line: u32[16]                       // history line holding write_pos
// Worker 0's inbox. Placement is deterministic, so the address is the same on
// every worker. Every worker rewrites its slot each launch, and worker 0 rearms
// the count after reading it. The next argmax launch starts only after this one
// finishes everywhere. (The old kernel zeroed the slots with a per-launch host
// write and polled a ready word in each slot; §12 item 7 replaces that with
// `keep` slots and an arrival count.)
l1 partials: u32[4 * grid.size], keep       // slot i = (key, token) of worker i
l1 arrived: u32[4], keep              // number of slots written this launch

sem dst_full = math_pack, max=1       // math -> pack: candidates are in Dst

// One Dst address of the scan. The page datum arrives in l1 (index in l5).
// Padding outside [lead, lead + count) gets key 0, which never beats a logit.
// Key: flip the magnitude bits of negatives, set the sign of nonnegatives, then
// shift right one, giving a nonnegative integer that orders like the value.
// BF16 has sixteen zero low bits, so dropping bit 0 loses nothing.
// Registers: l0/l4 best key/index, l1/l5 current, l2 scratch, l3 = 0x8000_0000,
// l6 = lead, l7 = lead + count.
macro scan_datum() {
    sfp.load l1, dst[0], fmt=fp32, addr=next  // also captures l5; dst += 2
    sfp.sar l2, l1, 31                        // all ones if negative, else 0
    sfp.or l2, l2, l3
    sfp.xor l1, l1, l2
    sfp.shr l1, l1, 1
    sfp.if l5 < l6 { sfp.mov l1, zero }
    sfp.if l5 >= l7 { sfp.mov l1, zero }
    sfp.minmax l1, l0                         // l0/l4 = max, ties keep l0/l4
    sfp.nop
}

fn brisc() {
    p = cb.reserve page
    noc.read p, logits[lo], n=lead + count, wait
    cb.push page

    // Best of the 32 lane candidates. Masked lanes may hold a padding index.
    c = cb.wait candidates
    best_key = 0
    best = 0
    for l in 0..32 {
        key = c[2 * l] >> 15   // 16-bit key: the BF16 bits in sortable order
        i = c[2 * l + 1]       // Dst index = datum index in page
        if i >= lead && i < lead + count {
            t = lo + i
            if key > best_key || key == best_key && t < best {
                best_key = key
                best = t
            }
        }
    }
    cb.pop candidates

    // To worker 0: payload acknowledged, then counted (§7 remote publication).
    local[0] = best_key
    local[1] = best + VOCAB_BASE
    noc.write remote(0, 0, partials + 4 * core.id), local, n=2, wait
    noc.inc remote(0, 0, arrived), by=1, ret=ack, wait

    if core.id != 0 { return }

    while arrived[0] != grid.size { fence }
    arrived[0] = 0             // rearm for the next launch
    best_key = 0
    best = 0
    for w in 0..grid.size {
        // Slices are in worker order, so on equal keys the earlier worker wins.
        if partials[4 * w] > best_key {
            best_key = partials[4 * w]
            best = partials[4 * w + 1]
        }
    }

    if TP {
        local[0] = best_key
        local[1] = best
        noc.write winner[0], local, n=4, wait
        return
    }
    if LINK_PICK {
        parity = step & 1
        local[0] = best_key
        local[1] = best
        noc.write noc_xy(ETH_X, ETH_Y, 0x40000 + parity * 0x8000), local, n=4, wait
        ack[0] = step
        ack[1] = 16
        ack[2] = 1
        ack[3] = 0
        noc.write noc_xy(ETH_X, ETH_Y, 0x30400), ack, n=4, wait
        loop {
            noc.read ack, noc_xy(ETH_X, ETH_Y, 0x60000 + parity * 16), n=4, wait
            if ack[0] == step { break }
        }
        noc.read ack, noc_xy(ETH_X, ETH_Y, 0x50000 + parity * 0x8000), n=4, wait
        if ack[0] > best_key || (ack[0] == best_key && ack[1] < best) { best = ack[1] }
    }
    local[0] = best
    noc.write tokens[4 * write_pos], local, n=4, wait     // 16 bytes to the host slot

    // Append to the history the embedding kernel reads, during generation only.
    // Read-modify-write of the aligned 16-word line so no neighbour changes.
    // GAP: a 4-byte DRAM write would do, if audit item 4 allows it.
    if write_token != 0 {
        noc.read line, history[write_pos & ~15], n=16, wait
        line[write_pos & 15] = best
        noc.write history[write_pos & ~15], line, n=16, wait
    }

    // The old kernel then wrote the next token's parameters into every worker's
    // parameter block for autonomous replay; parameters are host-bound per graph
    // run instead (§4, §12 item 7).
}

// Full-tile unpacks to SrcA. Math copies each bank into FP32 Dst.
fn trisc0() {
    unpack.fmt a, in=bf16
    p = cb.wait page
    repeat t in 0..TILES {
        tensix.stall unpack, srca_clr
        unpack.move a, p + t * 1024, n=1024, dvalid
    }
    tensix.wait
    cb.pop page
}

fn trisc1() {
    math.fmt dst=fp32, sfp=fp32
    math.cfg dst_offset=0
    math.addrmod next, slot=1, dst+=2

    // BF16 -> FP32 Dst through SrcA, preserving signed zero. The SFPU loads
    // only datums written here.
    sem.stall math|sfpu|sync, dst_full, notmax
    math.rwc reset
    repeat t in 0..TILES {
        tensix.stall math, srca_vld
        repeat r in 0..8 {
            math.mova2d dst[t * dst.tile + r * 8], src=r * 8, rows=8
        }
        math.rwc reset, release=a
    }
    tensix.stall sfpu, math

    sfp.li l0, 0, fmt=u32
    sfp.li l4, 0, fmt=u32
    sfp.li l3, 0x8000_0000, fmt=u32
    sfp.li l6, lead, fmt=u32
    sfp.li l7, lead + count, fmt=u32
    math.rwc reset
    sfp.index capture {
        loop TILES * 32 { scan_datum!() }
    }

    // 32 (key, index) pairs: lane l's key at Dst datum 2l, its index at 2l + 1.
    math.rwc reset
    sfp.store dst[0], l0, fmt=i32
    sfp.store dst[2], l4, fmt=i32
    tensix.stall sync, math|sfpu
    sem.inc dst_full
}

fn trisc2() {
    pack.fmt in=fp32, out=fp32
    sem.stall tdma|pack|sync, dst_full, nonzero
    c = cb.reserve candidates
    pack.move c, dst[0], n=64     // Dst rows 0..3 of face 0 = the 64 words
    tensix.stall sync, pack0
    tensix.wait
    cb.push candidates
    sem.dec dst_full
}
