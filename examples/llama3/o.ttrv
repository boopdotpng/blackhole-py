// Llama3 O and down projections: output = residual + W @ context.
// Compiled and checked on p150 by test_ttrv_hardware.py at both BF16 dimensions.
// 1B: EMBED_TILES=2, 8B BF16: EMBED_TILES=4, 8B FP8: EMBED_TILES=4 FP8=1.
// FP8:
// E4M3 weights; x is scaled by input_scale and rounded to E4M3 on the SFPU
// before the dot products, and each dot result is multiplied by output_scale.
// Runs on the first 88 workers; split() spreads the rows over them.
// Uses full-tile pack for each scalar result; pack.gather can replace it (spec §9).
// Numerical/layout/lowering obligations are in ../ttrv_port_review.md.
//
// Vectors stay in element order; nothing is tilized. A core owns output rows
// [first, first + count). With lead = first & 31, row first + i sits at element
// lead + i of the result, residual and summed pages, so the residual read and the
// output write are single ranges at the same offset modulo 64 bytes.

grid 88

const EMBED_TILES = 2
const DIM = EMBED_TILES * 1024
const INPUT_TILES = EMBED_TILES  // down uses 8 (1B) or 14 (8B)
const INPUT_DIM = INPUT_TILES * 1024
// Power-of-two CB capacity; each contiguous reservation divides a weight row.
const BATCH_TILES = INPUT_TILES & -INPUT_TILES
const FP8 = 0

// W is the weight element type: E4M3 for FP8, else BF16.
if FP8 { type W = e4m3 } else { type W = bf16 }

param context: bf16[]
param matrix: W[]
param output: bf16[]
param residual: bf16[]
// FP8: [input_scale, output_scale] for this layer. Float data lives in buffers (§4).
if FP8 { param scales: fp32[] }

shared {
    first, count = split(DIM)
    lo = first & ~31   // residual elements [lo, first + count): lo starts first's 64-byte line
    lead = first & 31  // row first + i is datum lead + i of the result, residual and summed pages
}

cb x: bf16[INPUT_DIM], pages=1                       // the whole context vector, read for every row
cb weights: W[1024], pages=2 * BATCH_TILES      // two contiguous reads in flight
cb dot: bf16[1024], pages=2                    // one packed dot result per page
cb result: bf16[1024], pages=1                 // this core's dot results, element lead + i
cb residual_slice: bf16[1024], pages=1         // this core's residual, same placement
cb summed: bf16[1024], pages=1                 // result + residual
if FP8 {
    cb xq: e4m3[INPUT_DIM], pages=1            // FP8: quantized x, packed by TRISC2
    cb scale_page: fp32[16], pages=1           // FP8: [input_scale, output_scale]
}

sem dst_full = math_pack, max=1                // math -> pack; max=1: one Dst result in flight
sem dst_bf16 = math_done, max=1                // math -> pack: Dst now holds bf16

if FP8 {
    // E4M3 operands need one fidelity phase.
    mop dot_face, outer=1, inner=2 {
        loop0: math.elwmul addr=step
        last: math.elwmul addr=next_face, release=a|b
    }
} else {
    // Same two-fidelity-phase face schedule as the current BF16 projection.
    mop dot_face, outer=2, inner=2 {
        loop0: math.elwmul addr=step
        last_inner: math.elwmul addr=rewind
        last: math.elwmul addr=next_face, release=a|b
    }
}

mop add_face, outer=1, inner=2 {
    loop0: math.elwadd addr=step
    last: math.elwadd addr=next_face, release=a|b
}

replay accumulate {
    sfp.load l0, dst[0], fmt=fp32
    sfp.mad l7, l0, one, l7
    math.rwc dst+=2
}

if FP8 {
    // One 4x8 footprint of x: scale by l12, round to E4M3 in FP32 form, store.
    // The packer truncates, so rounding (half to even), clamping to ±448 and
    // flushing E4M3 subnormals happen here. Constants: l1 = 0x7ffff, l2 = 1,
    // l3 = 0xfff00000, l5 = 448.0, l6 = -448.0, l13 = 2^-6 (smallest normal).
    // 23 words; with accumulate's 3 this fills 26 of the 32 replay words.
    replay to_fp8 {
        sfp.load l0, dst[0], fmt=fp32
        sfp.mul l0, l0, l12; sfp.nop
        sfp.shr l4, l0, 20          // bit 0: lowest kept mantissa bit
        sfp.and l4, l4, l2
        sfp.iadd l4, l1, l4         // 0x7ffff + lsb: ties to even
        sfp.iadd l0, l4, l0
        sfp.and l0, l0, l3          // keep 3 mantissa bits
        sfp.mov l7, l5
        sfp.minmax l0, l7; sfp.nop  // l0 = min(x, 448)
        sfp.mov l7, l6
        sfp.minmax l7, l0; sfp.nop  // l0 = max(x, -448)
        sfp.abs l4, l0, float
        sfp.mov l7, l13
        sfp.isub l7, l4, l7         // negative iff |x| < 2^-6
        sfp.shr l7, l7, 31
        sfp.iadd l7, l7, -1         // 0 for subnormals, all ones otherwise
        sfp.and l0, l0, l7
        sfp.store dst[0], l0, fmt=fp32
        math.rwc dst+=2
    }

    // Pack Dst row 0 to p without publishing; the caller pushes the whole vector.
    macro pack_tile(p) {
        sem.stall tdma|pack|sync, dst_full, nonzero
        pack.move p, dst[0]
        tensix.stall sync, pack0
        tensix.wait
        sem.dec dst_full
    }
}

// Reduce 32 running lane sums to one value in l0; clobbers l0-l3.
macro reduce_lanes(sum) {
    sfp.mov l0, sum
    repeat stage in 0..3 {
        sfp.mov l1, l0
        repeat 4 >> stage { sfp.shft2 l1, l1, rotate; sfp.nop }
        sfp.add l0, l0, l1; sfp.nop
    }
    sfp.mov l1, l0
    sfp.mov l2, l0
    sfp.mov l3, l0
    sfp.transp
    sfp.add l0, l0, l1; sfp.nop
    sfp.add l0, l0, l2; sfp.nop
    sfp.add l0, l0, l3; sfp.nop
}

// Face-by-face Src publication matches the compute MOP's release granularity.
macro unpack_pair(left, right) {
    repeat face in 0..4 {
        unpack.move a, left + face * 256, n=256, dvalid
        unpack.move b, right + face * 256, n=256, dvalid
    }
}

// Pack Dst row 0 into a fresh page of q, then hand Dst back to math.
macro pack_dst(q) {
    sem.stall tdma|pack|sync, dst_full, nonzero
    p = cb.reserve q
    pack.move p, dst[0]
    tensix.stall sync, pack0
    tensix.wait
    cb.push q
    sem.dec dst_full
}

fn brisc() {
    r = cb.reserve residual_slice
    a = noc.read r, residual[lo], n=first + count - lo

    v = cb.reserve x
    b = noc.read v, context[0], n=INPUT_DIM
    noc.wait a, b
    cb.push residual_slice
    cb.push x
    if FP8 {
        sc = cb.reserve scale_page
        noc.read sc, scales[0], n=2, wait
        cb.push scale_page
    }

    for row in first..first + count {
        for batch in 0..INPUT_TILES / BATCH_TILES {
            w = cb.reserve weights, n=BATCH_TILES
            noc.read w, matrix[row * INPUT_DIM + batch * BATCH_TILES * 1024], n=BATCH_TILES * 1024, port=core.id % 3, wait
            cb.push weights, n=BATCH_TILES
        }
    }
}

fn trisc0() {
    unpack.fmt a|b, in=bf16
    if FP8 {
        input = cb.wait x
        // Each context tile goes to SrcA whole; math copies it to Dst for the SFPU.
        for tile in 0..INPUT_TILES {
            unpack.move a, input + tile * 1024, n=1024, dvalid
        }
        tensix.wait
        cb.pop x
        unpack.fmt a|b, in=e4m3
        v = cb.wait xq               // the quantized vector replaces x from here on
    } else { v = cb.wait x }
    loop count {
        for tile in 0..INPUT_TILES {
            w = cb.wait weights
            unpack_pair!(w, v + tile * 1024)
            tensix.wait
            cb.pop weights
        }
    }
    if FP8 { unpack.fmt a|b, in=bf16 }

    y = cb.wait result
    r = cb.wait residual_slice
    unpack_pair!(y, r)
    tensix.wait
    cb.pop result
    cb.pop residual_slice
}

fn trisc1() {
    math.fmt dst=fp32, sfp=fp32
    math.cfg dst_offset=0
    math.addrmod step, slot=1, srca+=8, srcb+=8, dst+=8
    math.addrmod rewind, slot=2, srca=0, srcb=0, dst=cr+0, fidelity+=1
    math.addrmod next_face, slot=3, srca=0, srcb=0, dst=c+8, fidelity=0
    mop.load dot_face
    replay.load accumulate

    if FP8 {
        // x = round_e4m3(x * input_scale), one tile at a time through Dst tile 0.
        math.addrmod copy, slot=4, srca+=8, dst+=8
        replay.load to_fp8
        sc = cb.wait scale_page      // retained; launch state resets it
        sfp.const l12, sc[0], fmt=fp32
        sfp.const l13, 0.015625
        sfp.li l1, 0x7ffff, fmt=u32
        sfp.li l2, 1, fmt=u32
        sfp.li l3, 0xfff00000, fmt=u32
        sfp.li l5, 448.0
        sfp.li l6, -448.0
        loop INPUT_TILES {
            sem.stall math|sfpu|sync, dst_full, notmax
            math.rwc reset
            tensix.stall math, srca_vld
            repeat 8 { math.mova2d dst[0], addr=copy }
            math.rwc reset, release=a
            tensix.stall sfpu, math
            repeat 32 { replay.run to_fp8 }
            math.rwc dst=0
            tensix.stall sync, math|sfpu
            sem.inc dst_full
        }
        sfp.const l12, sc[1], fmt=fp32   // output_scale for every dot result
    }

    loop count {
        sem.stall math|sfpu|sync, dst_full, notmax
        sfp.li l7, 0.0
        loop INPUT_TILES {
            repeat face in 0..4 { math.zero face=face, fmt=fp32 }
            math.rwc reset
            repeat 4 { tensix.stall math, srca_vld|srcb_vld; mop.run dot_face }
            tensix.stall sfpu, math
            math.rwc reset
            repeat 4 {
                repeat 8 { replay.run accumulate }
                math.rwc dst=cr+8
                math.rwc dst=cr+8
            }
            math.rwc dst=0
            tensix.stall sync, math|sfpu
        }
        reduce_lanes!(l7)
        if FP8 { sfp.mul l0, l0, l12; sfp.nop }
        sfp.store dst[0], l0, fmt=fp32; sfp.nop
        tensix.stall sync, math|sfpu
        sem.inc dst_full
    }

    // Wait for the final scalar pack before changing the Dst interpretation.
    sem.stall math|sfpu|sync, dst_full, notmax
    tensix.wait
    math.fmt dst=bf16, sfp=bf16
    mop.load add_face
    tensix.wait
    sem.inc dst_bf16, risc

    math.rwc reset
    repeat 4 { tensix.stall math, srca_vld|srcb_vld; mop.run add_face }
    math.rwc reset
    tensix.stall sync, math|sfpu
    sem.inc dst_full
}

fn trisc2() {
    if FP8 {
        // E4M3 output reads Dst as fp16; the SFPU already rounded, so this is exact.
        pack.fmt in=fp16, out=e4m3
        q = cb.reserve xq
        for tile in 0..INPUT_TILES { pack_tile!(q + tile * 1024) }
        cb.push xq
    }
    pack.fmt in=fp32, out=bf16
    loop count { pack_dst!(dot) }

    // Math has switched Dst to bf16; switch pack's input to match.
    sem.stall tdma|pack|sync, dst_bf16, nonzero
    sem.dec dst_bf16
    tensix.wait
    pack.fmt in=bf16, out=bf16
    pack_dst!(summed)
}

// Elements outside [lead, lead + count) are never initialized or written out;
// the residual add is elementwise, so they cannot affect valid rows.
fn ncrisc() {
    y = cb.reserve result
    for i in 0..count {
        d = cb.wait dot
        y[lead + i] = d[0]
        cb.pop dot
    }
    cb.push result

    s = cb.wait summed
    noc.write output[first], s + lead, n=count, wait
    cb.pop summed
}
