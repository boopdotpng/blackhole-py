// Llama3 decode attention, split over cache partitions: RoPE(q, k), KV-cache append,
// softmax(q kᵀ / sqrt(d)) v streamed over 32-token cache blocks, then each KV head's
// first worker merges its partitions' (O, m, l) states and writes the context.
// Port of blackhole-py-old/examples/llama3/kernels.py, _attention_program (split path).
//
// One source for all three models; attention is BF16 in each:
//   1B:              -D HEAD_TILES=2
//   8B:              -D HEAD_TILES=4
// Decode uses 4 or 8 cache partitions. Prompt groups use one partition per query position and KV head.
// The unsplit baseline (partitions=0) is not ported.
// Grid: KV_HEADS * PARTITIONS workers (64 by default), as the old split attention.
// Params: buffers q_in, k_in, v_in, cos, sin, key_cache, value_cache, context;
// integer start_pos (the position of this launch's token, queued by the host before each run).
//
// Worker w handles KV head w / PARTITIONS and its query heads (four on Llama, seven on Nanbeige).
// Its phase p = w % PARTITIONS visits cache blocks p, p + live, p + 2*live, ... where
// live is how many partitions the context length uses (1, 4 or PARTITIONS). Workers
// with p >= live exit at once. The worker owning the block that holds the current token
// patches this launch's K/V row into that block in L1 and appends it to the cache.
//
// Differences from the old kernel, all visible below:
// - The only position input is start_pos. The block count, live partitions, the
//   mask tail (valid columns) and the token's cache row are derived from it in
//   `shared`, on every RISC.
// - BRISC, not NCRISC, appends the K/V row: it already holds the row for the patch.
// - Senders keep their state's tile order (O..., m, l); the merger's unpack reorders.
// - The merged context is rearranged into one dense L1 row and written with one request.

const HEAD_TILES = 2                         // 1B: 2 (head_dim 64), 8B: 4 (head_dim 128)
const HEAD_DIM = HEAD_TILES * 32
const HALF = HEAD_DIM / 2
const GROUP = 4                              // query heads per KV head
// By default one launch computes every query row of a KV head. A slice may override stride and offset.
const QUERY_STRIDE = GROUP
const QUERY_OFFSET = 0
const PACK_CONTEXT = 0  // projection row layout: 16 low halves followed by 16 high halves
const KV_HEADS = 8
const PARTITIONS = 8
const PROMPT_ROWS = 1
const Q_PITCH = ((KV_HEADS * QUERY_STRIDE * HEAD_DIM + 1023) / 1024) * 1024
const KV_PITCH = ((KV_HEADS * HEAD_DIM + 1023) / 1024) * 1024
const MAX_TOKENS = 8192
const SCALE = 1.0 / sqrt(HEAD_DIM)           // softmax scale
const CACHE_TILES_PER_HEAD = MAX_TOKENS / 32 * HEAD_TILES
const STATE_TILES = HEAD_TILES + 2           // O tiles, then m, then l
const STATE_ELEMS = STATE_TILES * 1024

// Dst tiles while attending: 0 scores / probabilities, 1..HEAD_TILES O, then m, l, alpha.
const S = 0
const M = (HEAD_TILES + 1) * dst.tile
const L = (HEAD_TILES + 2) * dst.tile
const ALPHA = (HEAD_TILES + 3) * dst.tile
// Dst tiles while merging: 0..HEAD_TILES-1 O, then m, l, then the incoming state's
// m' and l' (and each O' tile in turn, reusing m''s tile). alpha and beta live in
// rows of the m tile that hold no query row.
const MM = HEAD_TILES * dst.tile
const ML = (HEAD_TILES + 1) * dst.tile
const MNEW = (HEAD_TILES + 2) * dst.tile
const MNEW_L = (HEAD_TILES + 3) * dst.tile
const MALPHA = MM + 8
const MBETA = MM + 32

// Each group of four query rows occupies four consecutive tile rows. One SFPU address covers four rows and eight
// columns (§10 lanes), so addresses 0, 2, 16, 18 cover rows 0..3 in all 32 columns:
// chunk i is (i & 1) * ODD + (i >> 1) * RIGHT.
const ROW_GROUPS = (GROUP + 3) / 4
const ODD = 2
const RIGHT = dst.face

grid KV_HEADS * PARTITIONS * PROMPT_ROWS

param q_in: bf16[]         // dense q [32 * HEAD_DIM]
param k_in: bf16[]         // dense k [8 * HEAD_DIM]
param v_in: bf16[]         // dense v [8 * HEAD_DIM]
param cos: bf16[]          // [MAX_TOKENS, HEAD_DIM] by position
param sin: bf16[]          // [MAX_TOKENS, HEAD_DIM], -sin over the first half of each row
param key_cache: bf16[]    // per KV head: 256 blocks x HEAD_TILES tiles of 32 tokens x 32 features
param value_cache: bf16[]
param context: bf16[]      // dense [32 * HEAD_DIM]
param start_pos: u32   // this token's position

shared {
    prompt_row = core.id / (PARTITIONS * KV_HEADS)
    pos = start_pos + prompt_row
    q_base = prompt_row * Q_PITCH
    kv_base = prompt_row * KV_PITCH
    head = (core.id / PARTITIONS) % KV_HEADS
    phase = core.id % PARTITIONS
    merger = (core.id / PARTITIONS) * PARTITIONS                // phase 0 of this head merges
    merger_x = merger / 10                    // core.id = core.x * 10 + core.y (§4)
    merger_y = merger % 10

    // Work split. Partitions in use: 1 through 128 tokens, 4 through 2560, then all.
    blocks = pos / 32 + 1               // cache blocks holding tokens 0..start_pos
    live = 1 + (PROMPT_ROWS == 1) * (3 * (blocks > 4) + (PARTITIONS / 8) * 4 * (blocks > 80))
    // This phase visits blocks phase, phase + live, ...; meaningful only if phase < live.
    visits = (blocks + live - 1 - phase) / live
    owns = (blocks - 1) % live == phase       // owns the block holding the token
    tail_visit = (blocks - 1) / live          // that block's visit index
    token_row = pos & 31                // the token's row in its block
    valid_columns = token_row + 1             // mask tail: valid score columns in that block
}

// RoPE operands, row-major: rows 0..3 the group's query heads, row 4 its key head.
// Elementwise math does not care that these 1024-value pages are not tilized.
cb operands: bf16[1024], pages=4            // x, swapped halves, cos, sin
cb result: bf16[1024], pages=1              // rotated rows, same layout
cb query: bf16[1024], pages=HEAD_TILES      // tiled q: tile f row g = head g, features 32f..
cb rows: bf16[2 * HEAD_DIM], pages=1        // rotated k row, then the v row
cb keys: bf16[1024], pages=2 * HEAD_TILES
cb values: bf16[1024], pages=2 * HEAD_TILES
cb probs: bf16[1024], pages=1               // P of one block
if PARTITIONS > 1 {
cb state: fp32[STATE_ELEMS], pages=1        // this worker's (O, m, l)
cb states: fp32[STATE_ELEMS], pages=PARTITIONS  // merger: every partition's state, filled remotely
}
cb merged: bf16[HEAD_TILES * 1024], pages=1 // merger: normalized O

l1 dense: bf16[GROUP * HEAD_DIM]
l1 ret: u32[4]                              // noc.inc response slot
l1 arrived: u32[4], keep                    // merger: states received; rearmed after use

if PROMPT_ROWS > 1 {
    l1 append_data: bf16[4 * HEAD_DIM]
    l1 appended: u32[4], keep
    l1 cache_ready: u32[4], keep
    l1 notice: u32[4]
}

sem dst_ready = math_pack, max=1             // math -> pack: Dst holds a result

// ---- engine templates

const PHASES = 2
include ../common/matmul_phases

// x * cos + swapped * sin at one SFPU address of the four operand tiles.
replay rope_step {
    sfp.load l0, dst[0], fmt=fp32
    sfp.load l1, dst[dst.tile], fmt=fp32
    sfp.load l2, dst[2 * dst.tile], fmt=fp32
    sfp.load l3, dst[3 * dst.tile], fmt=fp32
    sfp.mul l0, l0, l2
    sfp.mad l0, l1, l3, l0
    sfp.rnd l0, l0, to=bf16
    sfp.store dst[0], l0, fmt=fp32, addr=sfp_step
}

include ../common/attention
include ../common/copy_tile

fn brisc() {
    if phase >= live { return }

    // RoPE operands; every read offset is a multiple of 64 bytes on both sides.
    o = cb.reserve operands, n=4
    x = o
    swapped = o + 1024
    t = noc.read x, q_in[q_base + (head * QUERY_STRIDE + QUERY_OFFSET) * HEAD_DIM], n=GROUP * HEAD_DIM
    noc.read x + GROUP * HEAD_DIM, k_in[kv_base + head * HEAD_DIM], n=HEAD_DIM, tid=t
    for r in 0..GROUP {
        row = (head * QUERY_STRIDE + QUERY_OFFSET + r) * HEAD_DIM
        noc.read swapped + r * HEAD_DIM, q_in[q_base + row + HALF], n=HALF, tid=t
        noc.read swapped + r * HEAD_DIM + HALF, q_in[q_base + row], n=HALF, tid=t
    }
    noc.read swapped + GROUP * HEAD_DIM, k_in[kv_base + head * HEAD_DIM + HALF], n=HALF, tid=t
    noc.read swapped + GROUP * HEAD_DIM + HALF, k_in[kv_base + head * HEAD_DIM], n=HALF, tid=t
    for r in 0..GROUP + 1 {
        noc.read o + 2048 + r * HEAD_DIM, cos[pos * HEAD_DIM], n=HEAD_DIM, tid=t
        noc.read o + 3072 + r * HEAD_DIM, sin[pos * HEAD_DIM], n=HEAD_DIM, tid=t
    }
    noc.wait t
    cb.push operands, n=4

    if PROMPT_ROWS > 1 {
        // Publish the complete set of cache rows before any query reads its causal prefix.
        rw = cb.wait rows
        shift = (token_row & 1) * 16
        for h in 0..2 * HEAD_TILES {
            l1.copy_words append_data + h * 32 + shift, rw + h * 16, n=8
            l1.copy_words append_data + 2 * HEAD_DIM + h * 32 + shift, rw + HEAD_DIM + h * 16, n=8
        }
        first = (head * CACHE_TILES_PER_HEAD + (blocks - 1) * HEAD_TILES) * 1024
        at = first + (token_row >> 4) * 512 + (token_row & 15) * 16
        wr = noc.write key_cache[at], append_data + shift, n=16
        noc.write value_cache[at], append_data + 2 * HEAD_DIM + shift, n=16, tid=wr
        for h in 1..2 * HEAD_TILES {
            off = at + (h / 2) * 1024 + (h % 2) * 256
            noc.write key_cache[off], append_data + h * 32 + shift, n=16, tid=wr
            noc.write value_cache[off], append_data + 2 * HEAD_DIM + h * 32 + shift, n=16, tid=wr
        }
        noc.wait wr
        cb.pop rows
        noc.inc remote(head / 10, head % 10, appended), by=1, ret=ret, wait
        if prompt_row == 0 {
            loop { if appended[0] == PROMPT_ROWS { break }; fence }
            appended[0] = 0
            notice[0] = 1
            for i in 1..PROMPT_ROWS {
                peer = i * KV_HEADS + head
                noc.write remote(peer / 10, peer % 10, cache_ready), notice, n=1, wait
            }
        } else {
            loop { if cache_ready[0] { break }; fence }
            cache_ready[0] = 0
        }
    }

    // Stream this phase's K and V blocks; spread reads over a bank's three ports.
    for i in 0..visits {
        block = phase + i * live
        first = (head * CACHE_TILES_PER_HEAD + block * HEAD_TILES) * 1024
        kp = cb.reserve keys, n=HEAD_TILES
        vp = cb.reserve values, n=HEAD_TILES
        // Issue the first K/V pair on compile-time ports before rotating the remaining reads.
        kr = noc.read kp, key_cache[first], n=1024, port=0
        vr = noc.read vp, value_cache[first], n=1024, port=HEAD_TILES % 3
        for f in 1..HEAD_TILES {
            noc.read kp + f * 1024, key_cache[first + f * 1024], n=1024, port=f % 3, tid=kr
            noc.read vp + f * 1024, value_cache[first + f * 1024], n=1024, port=(f + HEAD_TILES) % 3, tid=vr
        }
        noc.wait kr, vr
        if PROMPT_ROWS == 1 && owns && i == tail_visit {
            // This launch's rotated K and V replace token row token_row of every tile,
            // whatever the cache held there (its append may still be in flight).
            r = token_row
            rw = cb.wait rows
            for f in 0..HEAD_TILES {
                for c in 0..32 {
                    at = f * 1024 + (r >> 4) * 512 + (c >> 4) * 256 + (r & 15) * 16 + (c & 15)
                    kp[at] = rw[f * 32 + c]
                    vp[at] = rw[HEAD_DIM + f * 32 + c]
                }
            }
            // Append the row to the caches: 16 features per face row.
            // Write from the patched tile so the L1 and DRAM offsets agree modulo 64.
            for f in 0..HEAD_TILES {
                for h in 0..2 {
                    at = f * 1024 + (r >> 4) * 512 + h * 256 + (r & 15) * 16
                    noc.write key_cache[first + at], kp + at, n=16, wait
                    noc.write value_cache[first + at], vp + at, n=16, wait
                }
            }
            cb.pop rows
        }
        cb.push keys, n=HEAD_TILES
        cb.push values, n=HEAD_TILES
    }

    if PARTITIONS > 1 {
        // Merger: wait for every live state, rearm the counter, publish the states.
        if phase == 0 {
            loop {
                if arrived[0] == live { break }
                fence
            }
            fence
            arrived[0] = 0
            cb.reserve states, n=live
            cb.push states, n=live
        }
    }
}

fn trisc0() {
    if phase >= live { return }

    unpack.fmt a|b, in=bf16
    o = cb.wait operands, n=4
    repeat t in 0..4 { unpack.move a, o + t * 1024, dvalid }
    tensix.wait
    cb.pop operands, n=4

    q = cb.wait query, n=HEAD_TILES  // kept for every block
    for i in 0..visits {
        k = cb.wait keys, n=HEAD_TILES
        unpack.fmt a, in=bf16, transpose
        repeat f in 0..HEAD_TILES {
            unpack.move b, q + f * 1024, dvalid
            unpack.move a, k + f * 1024, dvalid
        }
        tensix.wait
        cb.pop keys, n=HEAD_TILES

        p = cb.wait probs
        v = cb.wait values, n=HEAD_TILES
        unpack.fmt a, in=bf16  // GAP: does .fmt without `transpose` clear it? Booleans have no "off" spelling (§2 rule 3)
        repeat f in 0..HEAD_TILES {
            unpack.move b, p, dvalid
            unpack.move a, v + f * 1024, dvalid
        }
        tensix.wait
        cb.pop values, n=HEAD_TILES
        cb.pop probs
    }
    cb.pop query, n=HEAD_TILES

    if PARTITIONS > 1 {
        // Merger: the first state in order, then each further state's m', l' and O' tiles.
        if phase == 0 {
            unpack.fmt a, in=fp32  // GAP: §9 requires out=bf16|fp16 for fp32 input; FP32 states want TF32 or better (§12 item 6)
            st = cb.wait states, n=live
            repeat t in 0..STATE_TILES { unpack.move a, st + t * 1024, dvalid }
            for s in 1..live {
                p = st + s * STATE_ELEMS
                unpack.move a, p + HEAD_TILES * 1024, dvalid
                unpack.move a, p + (HEAD_TILES + 1) * 1024, dvalid
                repeat f in 0..HEAD_TILES { unpack.move a, p + f * 1024, dvalid }
            }
            tensix.wait
            cb.pop states, n=live
        }
    }
}

fn trisc1() {
    if phase >= live { return }

    math.fmt dst=fp32, sfp=fp32
    math.cfg dst_offset=0
    matmul_addrmods!(32, 16)
    math.addrmod mm_col, slot=2, srca=cr+0, srcb=cr+32, dst+=8
    math.addrmod mm_b, slot=3, srcb+=8, dst+=8
    math.addrmod mm_phase, slot=5, srca=0, srcb=0, dst=0, fidelity+=1
    math.addrmod sfp_step, slot=6, dst+=2
    replay.load mm_first
    replay.load mm_second
    replay.load copy_rows
    replay.load rope_step
    mop.load matmul

    // RoPE: Dst tiles 0..3 = x, swapped, cos, sin; the rotated rows overwrite tile 0.
    sem.stall math|sfpu|sync, dst_ready, notmax
    repeat t in 0..4 { copy_tile!(t) }
    tensix.stall sfpu, math
    math.rwc reset
    loop 32 { replay.run rope_step }
    math.rwc reset
    tensix.stall sync, math|sfpu
    sem.inc dst_ready

    // O = 0, m = -inf, l = 0 in the live rows; every other row stays finite.
    sem.stall math|sfpu|sync, dst_ready, notmax
    sfp.li l0, 0.0
    repeat t in 1..HEAD_TILES + 2 { fill_tile!(t, l0) }
    fill_tile!(HEAD_TILES + 3, l0)
    sfp.li l1, 1.0
    fill_tile!(HEAD_TILES + 2, l1)
    sfp.li l0, -inf
    loop ROW_GROUPS {
        repeat offset in ROW_OFFSETS { sfp.store dst[M + offset], l0, fmt=fp32 }
        math.rwc dst+=4
    }
    math.rwc dst=0
    sfp.li l0, 0.0
    loop ROW_GROUPS {
        repeat offset in ROW_OFFSETS { sfp.store dst[L + offset], l0, fmt=fp32 }
        math.rwc dst+=4
    }
    math.rwc dst=0
    tensix.stall sync, math|sfpu

    for i in 0..visits {
        // scores = q kᵀ into tile 0, once pack has finished with the previous P
        sem.stall math|sfpu|sync, dst_ready, notmax
        matmul_addrmods!(32, 16)
        math.cfg dst_offset=0
        repeat face in 0..4 { math.zero face=face, fmt=fp32 }
        repeat f in 0..HEAD_TILES { product!() }

        tensix.stall sync, math|sfpu
        if owns && i == tail_visit {
            loop ROW_GROUPS { mask_tail!(valid_columns); math.rwc dst+=4 }
            math.rwc dst=0
            tensix.stall sync, sfpu
        }
        loop ROW_GROUPS { online_softmax!(HEAD_TILES); math.rwc dst+=4 }
        math.rwc dst=0
        sem.inc dst_ready

        // O += P v, once P is packed (unpack needs it anyway)
        sem.stall math|sfpu|sync, dst_ready, notmax
        matmul_addrmods!(16, 32)
        repeat f in 0..HEAD_TILES {
            math.cfg dst_offset=(1 + f) * dst.tile
            product!()
        }
        math.cfg dst_offset=0
    }

    if PARTITIONS > 1 {
        // Publish (O, m, l): Dst tiles 1..HEAD_TILES + 2.
        sem.stall math|sfpu|sync, dst_ready, notmax
        tensix.stall sync, math|sfpu
        sem.inc dst_ready

    }
    if phase == 0 {
        // m_new = max(m, m'), alpha = exp(m - m_new), beta = exp(m' - m_new),
        // l = l alpha + l' beta, O = O alpha + O' beta; finally O /= l.
        sem.stall math|sfpu|sync, dst_ready, notmax
        if PARTITIONS > 1 {
            repeat t in 0..STATE_TILES { copy_tile!(t) }
            for s in 1..live {
                copy_tile!(HEAD_TILES + 2)
                copy_tile!(HEAD_TILES + 3)
                tensix.stall sfpu, math
                merge_maxima!()
                exp_setup!()
                loop ROW_GROUPS {
                    repeat offset in ROW_OFFSETS { exp_exact_at!(MALPHA + offset) }
                    math.rwc dst+=4
                }
                math.rwc dst=0
                loop ROW_GROUPS {
                    repeat offset in ROW_OFFSETS { exp_exact_at!(MBETA + offset) }
                    math.rwc dst+=4
                }
                math.rwc dst=0
                loop ROW_GROUPS {
                    repeat offset in ROW_OFFSETS { merge_rows!(ML + offset, MNEW_L + offset) }
                    math.rwc dst+=4
                }
                math.rwc dst=0
                repeat f in 0..HEAD_TILES {
                    copy_tile!(HEAD_TILES + 2)  // O'_f
                    tensix.stall sfpu, math
                    loop ROW_GROUPS {
                        repeat offset in ROW_OFFSETS {
                            merge_rows!(f * dst.tile + offset, MNEW + offset)
                        }
                        math.rwc dst+=4
                    }
                    math.rwc dst=0
                }
                tensix.stall sync, math|sfpu
            }
        }
        loop ROW_GROUPS {
            repeat offset in ROW_OFFSETS {
                sfp.load l0, dst[ML + (PARTITIONS == 1) * dst.tile + offset], fmt=fp32
                recip_l0!()
                sfp.store dst[ML + (PARTITIONS == 1) * dst.tile + offset], l0, fmt=fp32
            }
            math.rwc dst+=4
        }
        math.rwc dst=0
        repeat f in 0..HEAD_TILES {
            loop ROW_GROUPS {
                repeat offset in ROW_OFFSETS {
                    sfp.load l0, dst[(f + (PARTITIONS == 1)) * dst.tile + offset], fmt=fp32
                    sfp.load l1, dst[ML + (PARTITIONS == 1) * dst.tile + offset], fmt=fp32
                    sfp.mul l0, l0, l1; sfp.nop
                    sfp.store dst[(f + (PARTITIONS == 1)) * dst.tile + offset], l0, fmt=fp32
                }
                math.rwc dst+=4
            }
            math.rwc dst=0
        }
        tensix.stall sync, math|sfpu
        sem.inc dst_ready
    }
}

fn trisc2() {
    if phase >= live { return }

    pack.fmt in=fp32, out=bf16
    pack_tile!(result, 0)
    loop visits { pack_tile!(probs, 0) }

    if PARTITIONS > 1 {
        sem.stall tdma|pack|sync, dst_ready, nonzero
        tensix.wait
        pack.fmt in=fp32, out=fp32
        p = cb.reserve state
        repeat t in 0..STATE_TILES { pack.move p + t * 1024, dst[(1 + t) * dst.tile] }
        tensix.stall sync, pack0
        tensix.wait
        cb.push state
        sem.dec dst_ready

    }
    if phase == 0 {
        sem.stall tdma|pack|sync, dst_ready, nonzero
        pack.fmt in=fp32, out=bf16
        out = cb.reserve merged
        repeat t in 0..HEAD_TILES { pack.move out + t * 1024, dst[(t + (PARTITIONS == 1)) * dst.tile] }
        tensix.stall sync, pack0
        tensix.wait
        cb.push merged
        sem.dec dst_ready
    }
}

fn ncrisc() {
    if phase >= live { return }

    // Query tiles: row g of tile f is head g's features 32f..32f+31; other rows zero.
    q = cb.reserve query, n=HEAD_TILES
    if PARTITIONS > 1 { for i in 0..HEAD_TILES * 1024 { q[i] = 0.0 } }
    res = cb.wait result
    for g in 0..GROUP {
        for f in 0..HEAD_TILES {
            l1.copy_words q + f * 1024 + g * 16, res + g * HEAD_DIM + f * 32, n=8
            l1.copy_words q + f * 1024 + g * 16 + 256, res + g * HEAD_DIM + f * 32 + 16, n=8
        }
    }
    cb.push query, n=HEAD_TILES

    // The token's owner: rotated k row and raw v row for BRISC's patch and append.
    if owns {
        rw = cb.reserve rows
        l1.copy_words rw, res + GROUP * HEAD_DIM, n=HEAD_DIM / 2
        noc.read rw + HEAD_DIM, v_in[kv_base + head * HEAD_DIM], n=HEAD_DIM, wait
        cb.push rows
    }
    cb.pop result

    if PARTITIONS > 1 {
        // Send (O, m, l) to slot `phase` of the merger's states ring, then count it.
        st = cb.wait state
        slot = states + phase * STATE_ELEMS
        for t in 0..STATE_TILES {
            noc.write remote(merger_x, merger_y, slot + t * 1024), st + t * 1024, n=1024, wait
        }
        noc.inc remote(merger_x, merger_y, arrived), by=1, ret=ret, wait
        cb.pop state

    }
    // Publish this KV head's context in dense or projection input order.
    if phase == 0 {
        o = cb.wait merged
        for g in 0..GROUP {
            for f in 0..HEAD_TILES {
                if PACK_CONTEXT {
                    l1.copy_words dense + g * HEAD_DIM + f * 16, o + f * 1024 + g * 16, n=8
                    l1.copy_words dense + g * HEAD_DIM + HALF + f * 16, o + f * 1024 + 256 + g * 16, n=8
                } else {
                    l1.copy_words dense + g * HEAD_DIM + f * 32, o + f * 1024 + g * 16, n=8
                    l1.copy_words dense + g * HEAD_DIM + f * 32 + 16, o + f * 1024 + 256 + g * 16, n=8
                }
            }
        }
        if PACK_CONTEXT {
            for g in 0..GROUP {
                start = (head * QUERY_STRIDE + QUERY_OFFSET + g) * HEAD_DIM
                lo = (start / 512) * 512 + (start & 511) / 2
                r = noc.write context[lo], dense + g * HEAD_DIM, n=HALF
                noc.write context[lo + 256], dense + g * HEAD_DIM + HALF, n=HALF, tid=r
                noc.wait r
            }
        } else { noc.write context[q_base + (head * QUERY_STRIDE + QUERY_OFFSET) * HEAD_DIM], dense, n=GROUP * HEAD_DIM, wait }
        cb.pop merged
    }
}
