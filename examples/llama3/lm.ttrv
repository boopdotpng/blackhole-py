// Llama3 LM head: logits = rmsnorm(x) @ Wlm.
// Port of blackhole-py-old/examples/llama3/kernels.py: projection(norm_weight=final_norm)
// for the "lm" program, with _rmsnorm / _rms_* / _projection_dot_math.
//
// One source, two builds:
//   1B    -D EMBED_TILES=2   (Wlm is the tied embedding table)
//   8B    -D EMBED_TILES=4
// Grid: 88 workers, as the old projection_cores.
// Params: buffers x, norm, wlm, logits; no integer params.
//
// Output layout (read by llama3_argmax.ttrv): logits is a dense row-major BF16
// vector of VOCAB elements, token t at element t. The old kernel instead wrote one
// compact tilized tile per core into that core's DRAM shard; with a dense vector
// argmax can split the vocabulary over any number of workers with split(VOCAB).
//
// Every worker redoes RMSNorm on the whole token, then owns vocabulary rows
// [first, first + count) (about 1458 on 88 workers, 1336 on 96). Row first + i is datum
// lead + i of the result page (lead = first & 31), so the output is one write at
// the same offset modulo 64 bytes. Each dot result is packed as a full tile and
// NCRISC copies its first datum, as in llama3_o.ttrv.

const EMBED_TILES = 2
const DIM = EMBED_TILES * 1024
const VOCAB = 128256
const PORT_COUNT = 3
const INV_DIM = 1.0 / DIM
const EPS = 1e-5

grid 88

param x: bf16[]               // dense token, DIM
param norm: bf16[]            // final RMSNorm gamma, DIM
param wlm: bf16[]             // [VOCAB, DIM] row-major
param logits: bf16[]          // dense, VOCAB

shared {
    first, count = split(VOCAB)
    lead = first & 31
}

cb operands: bf16[1024], pages=2 * EMBED_TILES   // x tiles, then gamma tiles
cb normalized: bf16[1024], pages=EMBED_TILES     // rmsnorm(x)
cb weights: bf16[1024], pages=2 * EMBED_TILES    // two weight rows in flight
cb dot: bf16[1024], pages=2                      // one packed dot result per page
// count <= ceil(VOCAB / 80) = 1604 rows, plus lead <= 31.
l1 result: bf16[2048]

sem dst_full = math_pack, max=1                  // math -> pack: one Dst result in flight

include dot_product
include rms_norm
include unpack_pair

fn brisc() {
    o = cb.reserve operands, n=2 * EMBED_TILES
    a = noc.read o, x[0], n=DIM, port=core.id % PORT_COUNT
    b = noc.read o + DIM, norm[0], n=DIM, port=core.id % PORT_COUNT
    noc.wait a, b
    cb.push operands, n=2 * EMBED_TILES

    for row in first..first + count {
        p = cb.reserve weights, n=EMBED_TILES
        noc.read p, wlm[row * DIM], n=DIM, port=core.id % PORT_COUNT, wait
        cb.push weights, n=EMBED_TILES
    }
}

fn trisc0() {
    unpack.fmt a, in=bf16
    o = cb.wait operands, n=2 * EMBED_TILES
    repeat t in 0..2 * EMBED_TILES {
        repeat face in 0..4 { unpack.move a, o + t * 1024 + face * 256, n=256, dvalid }
    }
    tensix.wait
    cb.pop operands, n=2 * EMBED_TILES

    v = cb.wait normalized, n=EMBED_TILES     // kept for the whole kernel, never popped
    unpack.fmt a|b, in=bf16
    loop count {
        for tile in 0..EMBED_TILES {
            w = cb.wait weights
            unpack_pair!(w, v + tile * 1024)
            tensix.wait
            cb.pop weights
        }
    }
}

fn trisc1() {
    math.fmt dst=fp32, sfp=fp32
    math.addrmod step, slot=1, srca+=8, srcb+=8, dst+=8
    math.addrmod rewind, slot=2, srca=0, srcb=0, dst=cr+0, fidelity+=1
    math.addrmod next_face, slot=3, srca=0, srcb=0, dst=c+8, fidelity=0
    sfpmacro.load scale_x
    replay.load square
    replay.load apply_pair
    replay.load accumulate

    // RMSNorm. Dst tiles [0, E) = x, [E, 2E) = gamma, FP32.
    sem.stall math|sfpu|sync, dst_full, notmax
    repeat t in 0..2 * EMBED_TILES {
        math.cfg dst_offset=t * dst.tile
        math.rwc reset
        repeat 4 {
            tensix.stall math, srca_vld
            math.mova2d addr=step
            math.mova2d addr=step
            math.rwc srca=0, srcb=0, release=a      // only A was published (§9)
        }
    }
    sfp.li l0, 0.0
    repeat t in 0..EMBED_TILES {
        math.cfg dst_offset=t * dst.tile
        tensix.stall sfpu, math
        over_tile!(square, 8)
        tensix.stall sync, math|sfpu
    }
    reduce_lanes!()
    rms_scale!()
    tensix.stall sync, math|sfpu
    repeat t in 0..EMBED_TILES {
        math.cfg dst_offset=t * dst.tile
        tensix.stall sfpu, math
        over_tile!(apply_pair, 4)
        tensix.stall sync, math|sfpu
    }
    sem.inc dst_full

    // One dot product per owned vocabulary row.
    math.cfg dst_offset=0
    mop.load dot_face
    loop count {
        sem.stall math|sfpu|sync, dst_full, notmax
        sfp.li l7, 0.0
        loop EMBED_TILES {
            repeat face in 0..4 { math.zero face=face, fmt=fp32 }
            math.rwc reset
            repeat 4 { tensix.stall math, srca_vld|srcb_vld; mop.run dot_face }
            tensix.stall sfpu, math
            over_tile!(accumulate, 8)
            tensix.stall sync, math|sfpu
        }
        sfp.mov l0, l7
        reduce_lanes!()
        sfp.store dst[0], l0, fmt=fp32; sfp.nop
        tensix.stall sync, math|sfpu
        sem.inc dst_full
    }
}

fn trisc2() {
    pack.fmt in=fp32, out=bf16
    sem.stall tdma|pack|sync, dst_full, nonzero
    n = cb.reserve normalized, n=EMBED_TILES
    repeat t in 0..EMBED_TILES { pack.move n + t * 1024, dst[t * dst.tile] }
    tensix.stall sync, pack0
    tensix.wait
    cb.push normalized, n=EMBED_TILES
    sem.dec dst_full

    loop count { pack_dst!(dot) }
}

// Datums outside [lead, lead + count) are never initialized or written out.
fn ncrisc() {
    for i in 0..count {
        d = cb.wait dot
        result[lead + i] = d[0]
        cb.pop dot
    }
    noc.write logits[first], result + lead, n=count, wait
}
