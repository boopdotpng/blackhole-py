// Dense BF16 token operations. Each worker writes up to 1024 consecutive elements.
// RMSNorm streams the whole token through Dst before applying this worker's gamma slice.
const DIM = 7168
const RMS = 0
const SWIGLU = 0
const PACKED = RMS + SWIGLU
const EPS = 1e-5
const TILES = (DIM + 1023) / 1024
const ROW_LANES = 1
grid TILES * ROW_LANES
param x: bf16[]
param other: bf16[]  // gamma, up projection, or residual
param output: bf16[]
shared {
    token_base = (core.id / TILES) * TILES * 1024
    first = (core.id % TILES) * 1024
    count = 1024 - (core.id % TILES == TILES - 1) * (TILES * 1024 - DIM)
}
cb inputs: bf16[1024], pages=2
cb result: bf16[1024], pages=1
if PACKED { l1 row: bf16[1024] }
sem ready = math_pack, max=1
const GAMMA = dst.tile
replay square {
    sfp.load l1, dst[0], fmt=fp32
    sfp.mad l0, l1, l1, l0
    math.rwc dst+=2
}

// x *= l0 (the broadcast reciprocal RMS) as the loaded value arrives.
sfpmacro rms_scale, slot=0 {
    mad: sfp.mul x, l0, x, delay=0
}

// x = x * scale * gamma for two independent footprints (even/odd columns).
replay rms_apply {
    sfpmacro.run rms_scale, l1, dst[0]
    sfp.load l2, dst[GAMMA], fmt=fp32
    sfpmacro.run rms_scale, l3, dst[2]
    sfp.load l4, dst[GAMMA + 2], fmt=fp32
    sfp.mul l1, l1, l2
    sfp.mul l3, l3, l4
    sfp.store dst[0], l1, fmt=fp32
    sfp.store dst[2], l3, fmt=fp32
    math.rwc dst+=2
    math.rwc dst+=2
}

macro select_tile(t) {
    tensix.stall sync, math|sfpu
    math.cfg dst_offset=t * dst.tile
    math.rwc reset
}

// Run a replay body `runs` times per face over the four faces of the tile.
macro faces(body, runs) {
    repeat 4 {
        repeat runs { replay.run body }
        math.rwc dst=cr+8
        math.rwc dst=cr+8
    }
    math.rwc dst=0
    tensix.stall sync, math|sfpu
}

// Copy one SrcA tile into Dst tile t. Only A was published, so only A is released (§9).
macro copy_tile(t) {
    select_tile!(t)
    tensix.stall math, srca_vld
    repeat 8 { math.mova2d addr=step }
    math.rwc reset, release=a
}

// Reduce 32 lane sums in l0 to one value broadcast to every lane; clobbers l0-l3.
macro reduce_lanes() {
    repeat stage in 0..3 {
        sfp.mov l1, l0
        repeat 4 >> stage { sfp.shft2 l1, l1, rotate; sfp.nop }
        sfp.add l0, l0, l1; sfp.nop
    }
    sfp.mov l1, l0
    sfp.mov l2, l0
    sfp.mov l3, l0
    sfp.transp
    sfp.add l0, l0, l1; sfp.nop
    sfp.add l0, l0, l2; sfp.nop
    sfp.add l0, l0, l3; sfp.nop
}

// l0 = 1 / sqrt(l0) for finite positive FP32 l0; clobbers l1-l6.
macro rsqrt() {
    alias v = l6
    alias y = l1
    alias t = l2
    alias c1 = l3
    alias c2 = l4
    alias half = l5
    sfp.mov v, l0
    sfp.mov y, v
    sfp.shr y, y, 1
    sfp.li t, 0x5f1110a0, fmt=u32
    sfp.isub y, t, y                   // magic - (bits >> 1)
    sfp.mul t, v, y; sfp.nop
    sfp.mul t, y, t, neg
    sfp.li c1, 2.2825186
    sfp.li c2, 2.2533049
    sfp.add c2, c2, t; sfp.nop
    sfp.mad t, t, c2, c1; sfp.nop
    sfp.mul y, y, t; sfp.nop
    sfp.mul t, v, y; sfp.nop
    sfp.mul t, y, t, neg; sfp.nop
    sfp.add t, one, t                  // 1 - v * y * y
    sfp.li half, 0.5
    sfp.mul half, y, half; sfp.nop
    sfp.mad l0, t, half, y             // one Newton step
}

macro exp() {
    alias xlog2 = l3
    alias e = l1
    alias poly = l2
    sfp.mad xlog2, l0, l12, l4         // x * log2(e) + 127
    sfp.li e, 255.0
    sfp.minmax xlog2, e                // xlog2 = min(xlog2, 255)
    sfp.exexp e, xlog2
    sfp.exman l0, xlog2
    sfp.shift l0, l0, e
    sfp.exman e, l0, hidden=0
    sfp.cast e, e
    sfp.mad poly, e, l13, l5
    sfp.mad e, poly, e, l6
    // The old kernel builds a mask with SFPGT's write-to-VD mode and ANDs it in.
    sfp.if xlog2 <= zero { sfp.mov l0, zero }
    sfp.setexp l0, e, l0, from=fp32
}

// l0 = 1 / l0 (ttko reciprocal); clobbers l1-l3.
macro recip() {
    alias y = l1
    alias err = l2
    alias corr = l3
    sfp.recip y, l0
    sfp.mad err, l0, y, one, neg_ab    // 1 - x * y
    sfp.mad corr, err, err, err
    sfp.mad corr, corr, err, err
    sfp.minmax corr, one               // corr = min(corr, 1)
    sfp.mad l0, corr, y, y
}

// silu, part 1, per row group of tile 0: keep gate in tile 2, store e^-gate.
macro silu_exp() {
    sfp.load l0, dst[0], fmt=fp32
    sfp.store dst[2 * dst.tile], l0, fmt=fp32
    sfp.mul l0, l0, neg_one
    exp!()
    sfp.store dst[0], l0, fmt=fp32
    math.rwc dst+=2
}

// silu, part 2: gate / (1 + e^-gate) * up.
macro silu_combine() {
    sfp.load l0, dst[0], fmt=fp32
    sfp.addi l0, l0, 1.0
    recip!()
    sfp.load l4, dst[2 * dst.tile], fmt=fp32
    sfp.load l5, dst[dst.tile], fmt=fp32
    sfp.mul l4, l4, l0
    sfp.mul l4, l4, l5
    sfp.store dst[0], l4, fmt=fp32
    math.rwc dst+=2
}

fn brisc() {
    if RMS {
        for i in 0..TILES {
            p = cb.reserve inputs
            noc.read p, x[token_base + i * 1024], n=1024, wait
            cb.push inputs
        }
    }
    a = cb.reserve inputs
    noc.read a, x[token_base + first], n=count, wait
    cb.push inputs
    b = cb.reserve inputs
    noc.read b, other[(1 - RMS) * token_base + first], n=count, wait
    cb.push inputs
}

fn trisc0() {
    unpack.fmt a, in=bf16
    loop 2 + RMS * TILES {
        p = cb.wait inputs
        unpack.move a, p, dvalid
        tensix.wait
        cb.pop inputs
    }
}

fn trisc1() {
    math.fmt dst=fp32, sfp=fp32
    math.addrmod step, slot=1, srca+=8, dst+=8
    if RMS {
        replay.load square
        sfpmacro.load rms_scale
        replay.load rms_apply
        sfp.li l0, 0.0
        loop TILES {
            copy_tile!(0)
            select_tile!(0)
            faces!(square, 8)
        }
        reduce_lanes!()
        sfp.li l4, 1.0 / DIM
        sfp.mul l0, l0, l4
        sfp.li l4, EPS
        sfp.add l0, l0, l4; sfp.nop
        rsqrt!()
    }
    copy_tile!(0)
    copy_tile!(1)
    select_tile!(0)
    if RMS { faces!(rms_apply, 4) }
    if SWIGLU {
        sfp.const l12, 1.4426950216293335    // log2(e); overwrites l0
        sfp.const l13, 4.791750143340323e-15
        sfp.li l4, 127.0
        sfp.li l5, 7.839635491371155e-08
        sfp.li l6, 1.0017248
        // These bodies exceed the replay buffer; loop on the TRISC instead.
        loop 4 {
            loop 8 { silu_exp!() }
            math.rwc dst=cr+8
            math.rwc dst=cr+8
        }
        math.rwc dst=0
        tensix.stall sync, math|sfpu
        loop 4 {
            loop 8 { silu_combine!() }
            math.rwc dst=cr+8
            math.rwc dst=cr+8
        }
        math.rwc dst=0
        tensix.stall sync, math|sfpu
    }
    if RMS + SWIGLU == 0 {
        loop 4 {
            loop 8 {
                sfp.load l0, dst[0], fmt=fp32
                sfp.load l1, dst[dst.tile], fmt=fp32
                sfp.add l0, l0, l1; sfp.nop
                sfp.store dst[0], l0, fmt=fp32
                math.rwc dst+=2
            }
            math.rwc dst=cr+8
            math.rwc dst=cr+8
        }
    }
    tensix.stall sync, math|sfpu
    sem.inc ready
}

fn trisc2() {
    pack.fmt in=fp32, out=bf16
    sem.stall tdma|pack|sync, ready, nonzero
    p = cb.reserve result
    pack.move p, dst[0]
    tensix.stall sync, pack0
    tensix.wait
    cb.push result
    sem.dec ready
}

fn ncrisc() {
    r = cb.wait result
    if PACKED {
        // Put the two 16-wide halves 256 elements apart for the matrix unit's face layout.
        for k in 0..count / 32 {
            offset = (k / 16) * 512 + (k & 15) * 16
            repeat i in 0..16 {
                row[offset + i] = r[k * 32 + i]
                row[offset + 256 + i] = r[k * 32 + i + 16]
            }
        }
        noc.write output[token_base + first], row, n=count, wait
    } else { noc.write output[token_base + first], r, n=count, wait }
    cb.pop result
}
