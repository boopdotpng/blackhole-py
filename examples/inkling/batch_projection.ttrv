// Inkling's batched (prompt-panel) projections: examples/nanbeige/projection.ttrv with FP32 outputs (OUT32, for the
// router logits and the message gates' forget/gain projection) and an explicit first-output row pitch. Only the
// PREFILL row-major path supports OUT32.
// Prompt panels or a single decode token times face-packed W[K,N]. Each worker owns complete 32-column output tiles.
const WORKERS = 112
grid WORKERS
const K = 7168
const N = 7168
const PREFILL = 0
const INPUT_SEGMENTS = 1
const TILE_ROWS = 16
const SHORT_M = 1
const SHARE_A = 0
const PACKED_SHARD = 0
if PACKED_SHARD { l1 packed_shard: bf16[1024], at=PACKED_SHARD }
const PANELS = 1
const SHARE_W = 1
const TILED_OUT = 0   // prompt outputs as panel tiles (requires PREFILL, TILE_ROWS 32)
const MULTICAST_W = SHARE_W && PANELS > 1   // one DRAM reader per group of token panels
const EARLY_WEIGHTS = 1 - (PREFILL != 0)
const DEPTH = 2   // ring blocks in flight per worker; at most PANELS, so a reservation count cannot run a block ahead
if MULTICAST_W {
    l1 b_ready: u32[4], keep                 // ring reservations received for the blocks this worker sends
    l1 b_sent: u32[4], keep                  // per ring slot: the block has landed here (cleared by trisc0)
    l1 ack: u32[4]
    l1 one: u32[4]
}
if SHARE_A { l1 received: u32[16], keep }
const BITS = 8
if BITS == 4 { type W = bfp4 } else { if BITS == 8 { type W = bfp8 } else { type W = bf16 } }

param x: bf16[]
const GROUP = 8
param weights: W[], tiles_per_page=GROUP
const OUT32 = 0
if OUT32 { type O = fp32 } else { type O = bf16 }
param output: O[]
const SECOND = 0
const THIRD = 0
if SECOND { param output2: O[] }
if THIRD { param output3: O[] }
// Stripe output columns over adjacent workers so adjacent workers fetch from different DRAM banks.
const KT = K / 32
// Activations are face-packed in 512-element blocks (a 32-element chunk's high half sits 256 after its low half). When K
// ends in a partial block, a decode read covers the rest of that block too; the x buffer must be allocated that long.
const X_TAIL = (512 - K % 512) % 512
const NT = N / 32
// Weight page (k group g, output column c) is page g * NT_PITCH + c. With PAD an even NT gets one blank page per
// k group, so a column's K pages rotate over the eight DRAM banks (bank = page % 8) instead of sharing one.
const PAD = 0
const NT_PITCH = NT + PAD * (1 - NT % 2)
const BATCH = 16
const BLOCKS = KT / BATCH
if MULTICAST_W { l1 stage: W[BATCH * 1024] }   // the next block this panel multicasts
const PORT_WORKERS = 8
// Decode stripes output columns over adjacent workers so they fetch from different DRAM banks. A multicast prompt
// gives each column group a contiguous range instead, so a row of RUN adjacent output tiles leaves in one write.
// Groups start at different points of their ranges so that concurrent weight reads spread over the DRAM banks.
const RUN = 1 + 3 * MULTICAST_W
shared { port_id = core.id / PORT_WORKERS % 3
    column_id = core.id / PANELS
    column_workers = grid.size / PANELS
    panel = core.id % PANELS
    per = (NT + column_workers - 1) / column_workers
    first_col = column_id * (1 + (per - 1) * MULTICAST_W)
    col_step = column_workers - (column_workers - 1) * MULTICAST_W
    left = (NT - first_col) * (first_col < NT)
    count = MULTICAST_W * (left - (left - per) * (left > per)) + (1 - MULTICAST_W) * ((NT + column_workers - 1 - column_id) / column_workers)
    rot = column_id * MULTICAST_W }
if PREFILL { param rows: u32 }
l1 line: O[32 * RUN * (1 + PREFILL * (TILE_ROWS - 1)) * (1 - TILED_OUT) + 16 * TILED_OUT]
cb activations: bf16[(1 + (TILE_ROWS - 1) * PREFILL) * K * INPUT_SEGMENTS + 1024], pages=1
cb matrices: W[1024], pages=DEPTH * BATCH
cb results: O[1024], pages=2
sem ready = math_pack, max=1

// BFP4 weights have three mantissa bits, all inside the first fidelity phase: the second would multiply zeros.
const PHASES = 2 - (BITS == 4)
include ../common/matmul_phases


// One 8-row MVMUL per input/output face pair. The second pass accumulates the low fidelity bits.
if PREFILL {
    replay prompt_phase {
        math.mvmul addr=prompt_col
        math.mvmul addr=prompt_k
        math.mvmul addr=prompt_col
        math.mvmul addr=mm_phase
    }
}

// Reads W block m (BATCH K tiles of this column's output tile m / BLOCKS) into dst under the given read group.
macro fetch(dst, m, reads) {
    fcol = first_col + ((m / BLOCKS + rot) % count) * col_step
    tile = (((m % BLOCKS) * (BATCH / GROUP)) * NT_PITCH + fcol) * GROUP
    for i in 0..BATCH / GROUP {
        noc.read tileptr(dst, i * GROUP), tileptr(weights, tile + i * NT_PITCH * GROUP), port=port_id, n=GROUP * 1024, tid=reads
    }
}

fn brisc() {
    if MULTICAST_W {
        // Block n goes to every panel of the column from panel n % PANELS. Each panel prefetches the next block it
        // sends into its staging buffer as soon as the last one has left, so all PANELS workers of a column read DRAM.
        // BRISC only reserves ring slots and tells each block's sender; trisc0 waits for the block's flag. Receivers
        // therefore run up to DEPTH blocks ahead, and senders multicast as soon as every slot is free.
        y0 = core.y - panel
        total = count * BLOCKS
        for i in 0..4 { one[i] = 1 }   // a 4-byte NoC write keeps its 16-byte offset: every word is the flag
        reads = noc.group read
        if panel < total { fetch!(stage, panel, reads) }
        sends = 0
        for n in 0..total {
            w = cb.reserve matrices, n=BATCH
            sender = n % PANELS
            if sender == panel {
                noc.wait reads
                sends = sends + 1
                // The count only grows during a launch, so an early reservation for a later block cannot be lost.
                loop { if b_ready[0] >= sends * (PANELS - 1) { break }; fence }
                for i in 0..BATCH / GROUP {
                    noc.mcast rect(core.x, y0, core.x, y0 + PANELS - 1, tileptr(w, i * GROUP)), tileptr(stage, i * GROUP), n=GROUP * 1024, include_sender, wait
                }
                // Same route and virtual channel as the data, so the flag lands after it.
                noc.mcast rect(core.x, y0, core.x, y0 + PANELS - 1, b_sent + n % DEPTH), one, n=1, include_sender, wait
                m = n + PANELS
                if m < total { fetch!(stage, m, reads) }
            } else {
                noc.inc remote(core.x, y0 + sender, b_ready), by=1, ret=ack, wait
            }
            cb.push matrices, n=BATCH
        }
        noc.wait reads   // every prefetch is consumed above; this only satisfies the checker
        b_ready[0] = 0   // every reservation for this worker's blocks has arrived
    } else {
        for j in 0..count {
            col = first_col + j * col_step
            for block in 0..BLOCKS {
                w = cb.reserve matrices, n=BATCH
                tile = ((block * (BATCH / GROUP)) * NT_PITCH + col) * GROUP
                r = noc.read w, tileptr(weights, tile), port=port_id, n=GROUP * 1024
                for i in 1..BATCH / GROUP {
                    noc.read tileptr(w, i * GROUP), tileptr(weights, tile + i * NT_PITCH * GROUP), port=port_id, n=GROUP * 1024, tid=r
                }
                noc.wait r
                cb.push matrices, n=BATCH
            }
        }
    }
}

fn trisc0() {
    unpack.fmt a, in=W
    unpack.fmt b, in=bf16
    if BITS == 16 { unpack.shape a, n=1024, faces=1 } else { unpack.shape a, n=256, faces=4 }
    unpack.shape b, n=1024, faces=1
    a = cb.wait activations
    landed = 0
    for j in 0..count {
        activation = a
        if INPUT_SEGMENTS == 3 {
            col = first_col + j * col_step
            activation = a + ((col >= (N - SECOND - THIRD) / 32) + (col >= (N - THIRD) / 32)) * TILE_ROWS * K
        }
        for block in 0..KT / BATCH {
            w = cb.wait matrices, n=BATCH
            if MULTICAST_W {
                loop { if b_sent[landed % DEPTH] { break }; fence }
                b_sent[landed % DEPTH] = 0
                landed = landed + 1
            }
            if PREFILL {
                // Bases go through the Tensix stream, so the RISC never waits on an unpack. Prompt tiles are
                // contiguous in L1 for each k: 32-row activation tiles step by one tile per Z, and so do BF16 weights.
                // BFP weight tiles each carry their own exponents, so their base is written per tile.
                if TILE_ROWS == 32 { unpack.base b, activation + block * BATCH * 1024, stream }
                if BITS == 16 { unpack.base a, w, stream }
                unpack.reset_zw a|b
                for i in 0..BATCH {
                    if TILE_ROWS != 32 { unpack.base b, activation + (block * BATCH + i) * TILE_ROWS * 32, stream }
                    if BITS != 16 {
                        unpack.base a, tileptr(w, i), stream
                        unpack.reset_zw a
                    }
                    if TILE_ROWS != 32 { unpack.reset_zw b }
                    tensix.stall unpack, srca_clr|srcb_clr
                    unpack.face b, next_l1_face, dvalid
                    if BITS == 16 { unpack.face a, next_l1_face, dvalid } else {
                        repeat 3 { unpack.face a, next_tile_face }
                        unpack.face a, next_tile_face, dvalid
                    }
                }
                tensix.stall sync, unpack0|unpack1
            } else {
            for i in 0..BATCH {
                k = block * BATCH + i
                unpack.acquire
                if PREFILL { unpack.base b, a + k * TILE_ROWS * 32 }
                else { unpack.base b, a + (k / 16) * 512 + (k & 15) * 16 }
                unpack.base a, tileptr(w, i)
                unpack.post
                tensix.stall unpack, srca_clr|srcb_clr
                unpack.reset_zw a|b
                tensix.stall unpack, trisc_cfg
                unpack.face b, dvalid
                if BITS == 16 { unpack.face a, dvalid } else {
                    repeat 3 { unpack.face a, next_tile_face }
                    unpack.face a, next_tile_face, dvalid
                }
                tensix.stall sync, unpack0|unpack1
                unpack.release
            }
            }
            tensix.wait
            cb.pop matrices, n=BATCH
        }
    }
    cb.pop activations
}

fn trisc1() {
    math.fmt dst=fp32, sfp=fp32
    math.cfg dst_offset=0
    math.addrmod mm_k, slot=1, srca+=16, srcb=cr+0, dst+=8
    math.addrmod mm_col, slot=2, srca=cr+0, srcb=cr+32, dst+=8
    math.addrmod mm_b, slot=3, srcb+=8, dst+=8
    math.addrmod mm_row, slot=4, srca=cr+32, srcb=cr+48, dst=cr+0
    math.addrmod mm_phase, slot=5, srca=0, srcb=0, dst=0, fidelity+=1
    if PREFILL {
        math.addrmod prompt_col, slot=6, srca+=16, dst+=16
        math.addrmod prompt_k, slot=7, srca+=16, srcb+=16, dst=0
        replay.load prompt_phase
    }
    replay.load mm_first
    replay.load mm_second
    mop.load matmul
    for j in 0..count {
        sem.stall math|sync, ready, notmax
        repeat face in 0..4 { math.zero face=face, fmt=fp32 }
        for k in 0..K / 32 {
            math.rwc reset
            tensix.stall math, srca_vld|srcb_vld
            if PREFILL && SHORT_M {
                replay.run prompt_phase
                if PHASES == 2 { replay.run prompt_phase }
                math.rwc reset, release=a|b
            } else {
                mop.run matmul
                math.rwc reset, release=b
            }
        }
        tensix.stall sync, math
        sem.inc ready
    }
}

fn trisc2() {
    if OUT32 { pack.fmt in=fp32, out=fp32 } else { pack.fmt in=fp32, out=bf16 }
    for j in 0..count {
        sem.stall tdma|pack|sync, ready, nonzero
        p = cb.reserve results
        pack.move p, dst[0]
        tensix.stall sync, pack0
        tensix.wait
        cb.push results
        sem.dec ready
    }
}

macro store_row(dest, col) { noc.write dest[col], line, n=32, wait }

// Write the gathered run of `run` adjacent output tiles: one request per prompt row.
const OUTPUT_STRIDE = ((N - SECOND - THIRD + 1023) / 1024) * 1024
const OUTPUT2_STRIDE = ((SECOND + 1023) / 1024) * 1024
const OUTPUT3_STRIDE = ((THIRD + 1023) / 1024) * 1024
macro flush_rows(dest, stride) {
    base = panel * TILE_ROWS * stride + run_col
    tx = noc.write dest[base], line, n=run * 32
    for r in 1..rows {
        noc.write dest[base + r * stride], line + r * (32 * RUN), n=run * 32, tid=tx
    }
    noc.wait tx
}

macro flush() {
    if THIRD { if run_out == 2 { flush_rows!(output3, OUTPUT3_STRIDE) } }
    if SECOND { if run_out == 1 { flush_rows!(output2, OUTPUT2_STRIDE) } }
    if run_out == 0 { flush_rows!(output, OUTPUT_STRIDE) }
}

fn ncrisc() {
    a = cb.reserve activations
    if SHARE_A {
        // Peers covering the same prompt panel gather disjoint stripes into the same L1 layout.
        // Every sender uses one ordered multicast stream for its data followed by its flag.
        lanes = 10
        if core.x * 10 + 10 > grid.size { lanes = grid.size - core.x * 10 }
        lane = core.y
        x0 = core.x
        x1 = core.x
        y0 = 0
        y1 = lanes - 1
        if PANELS > 1 {
            // Same y across worker columns computes the same prompt panel.
            // Split at the physical gap between the two sets of Tensix columns.
            x0 = (core.x / 7) * 7
            lanes = (grid.size + 9 - core.y) / 10 - x0
            if lanes > 7 { lanes = 7 }
            lane = core.x - x0
            x1 = x0 + lanes - 1
            y0 = core.y
            y1 = core.y
        }
        chunks = INPUT_SEGMENTS * K * TILE_ROWS / 8192
        lo = chunks * lane / lanes
        hi = chunks * (lane + 1) / lanes
        if hi > lo {
            noc.read a + lo * 8192, x[panel * INPUT_SEGMENTS * TILE_ROWS * K + lo * 8192], n=(hi - lo) * 8192, wait
            for b in lo..hi {
                noc.mcast rect(x0, y0, x1, y1, a + b * 8192), a + b * 8192, n=8192, wait
            }
        }
        received[lane] = 1
        noc.mcast rect(x0, y0, x1, y1, received + lane), received + lane, n=1, wait
        for peer in 0..lanes {
            loop {
                if received[peer] { break }
                fence
            }
            received[peer] = 0
        }
    } else {
        if PACKED_SHARD {
            t = noc.group read
            for j in 0..(K + 1023) / 1024 {
                owner = (j + core.id) % ((K + 1023) / 1024)
                noc.read a + owner * 1024, remote(owner / 10, owner % 10, packed_shard), n=1024, tid=t
            }
            noc.wait t
        } else {
            noc.read a, x[panel * INPUT_SEGMENTS * TILE_ROWS * K], n=INPUT_SEGMENTS * K * (1 + (TILE_ROWS - 1) * PREFILL) + X_TAIL * (1 - PREFILL), wait
        }
    }
    cb.push activations
    if TILED_OUT {
        // Prompt outputs stay in panel tile layout: each result tile leaves in one write.
        for j in 0..count {
            p = cb.wait results
            col = first_col + ((j + rot) % count) * col_step
            if THIRD {
                if col >= (N - THIRD) / 32 {
                    noc.write output3[(panel * (THIRD / 32) + col - (N - THIRD) / 32) * 1024], p, n=1024, wait
                } else {
                    if col >= (N - THIRD - SECOND) / 32 {
                        noc.write output2[(panel * (SECOND / 32) + col - (N - THIRD - SECOND) / 32) * 1024], p, n=1024, wait
                    } else { noc.write output[(panel * ((N - SECOND - THIRD) / 32) + col) * 1024], p, n=1024, wait }
                }
            } else {
                if SECOND {
                    if col >= (N - SECOND) / 32 {
                        noc.write output2[(panel * (SECOND / 32) + col - (N - SECOND) / 32) * 1024], p, n=1024, wait
                    } else { noc.write output[(panel * ((N - SECOND) / 32) + col) * 1024], p, n=1024, wait }
                } else { noc.write output[(panel * (N / 32) + col) * 1024], p, n=1024, wait }
            }
            cb.pop results
        }
    } else {
    if PREFILL {
        run = 0       // output tiles gathered in line
        run_col = 0   // the run's first column within its output
        run_out = 0   // which output the run belongs to
        for j in 0..count {
            p = cb.wait results
            col = (first_col + ((j + rot) % count) * col_step) * 32
            out = 0
            dcol = col
            if THIRD { if col >= N - THIRD { out = 2; dcol = col - (N - THIRD) } }
            if SECOND { if out == 0 { if col >= N - THIRD - SECOND { out = 1; dcol = col - (N - THIRD - SECOND) } } }
            if run { if out != run_out || run == RUN || dcol != run_col + run * 32 { flush!(); run = 0 } }
            if run == 0 { run_col = dcol; run_out = out }
            for r in 0..rows {
                src = p + (r / 16) * 512 + (r % 16) * 16
                l1.copy_words line + r * (32 * RUN) + run * 32, src, n=8 + 8 * OUT32
                l1.copy_words line + r * (32 * RUN) + run * 32 + 16, src + 256, n=8 + 8 * OUT32
            }
            run = run + 1
            cb.pop results
        }
        if run { flush!() }
    } else {
        for j in 0..count {
            p = cb.wait results
            for i in 0..16 {
                line[i] = p[i]
                line[i + 16] = p[256 + i]
            }
            col = (first_col + j * col_step) * 32
            if THIRD {
                if col >= N - THIRD { store_row!(output3, col - (N - THIRD)) }
                else {
                    if col >= N - THIRD - SECOND { store_row!(output2, col - (N - THIRD - SECOND)) }
                    else { store_row!(output, col) }
                }
            } else {
                if SECOND {
                    if col >= N - SECOND { store_row!(output2, col - (N - SECOND)) }
                    else { store_row!(output, col) }
                } else { store_row!(output, col) }
            }
            cb.pop results
        }
    }
    }
}
