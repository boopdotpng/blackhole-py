// Inkling expert activations (reference.swiglu with the routing weight folded in):
//   a[s, i] = w_s * tanh(g / GC) GC sigmoid(g) * tanh(u / UC) UC,   w_s = score_s / Σ score * SCALE
// over the routed experts' gate/up rows (experts.ttrv SELECT=1: slot s is [gate (INTER) | up (INTER)]).
// The output is the down projection's input: all SLOTS * INTER values face-packed as one vector.
//
// Grid: SLOTS * INTER / 1024 workers, 1024 outputs each. A worker's outputs span at most two slots; the part is a
// multiple of 128, so each part is whole SFPU addresses.
const INTER = 1152
const SLOTS = 8
const GC = 4.0
const UC = 25.0
const SCALE = 8.0
const CHUNK = 1024       // outputs per worker (512 when SLOTS * INTER is not a multiple of 1024)
grid SLOTS * INTER / CHUNK

param gate_up: bf16[]  // [SLOTS][2 * INTER]
param score: fp32[]    // [16], SLOTS valid
param output: bf16[]   // [SLOTS * INTER] face-packed

shared {
    first = core.id * CHUNK
    slot = first / INTER
    offset = first % INTER
    rest = INTER - offset
    part = rest - (rest - CHUNK) * (rest > CHUNK)   // outputs from the first slot
}

cb inputs: bf16[1024], pages=2
cb scores: u32[16], pages=1
cb result: bf16[1024], pages=1
l1 sc: fp32[16]
l1 row: bf16[1024]
sem ready = math_pack, max=1

include ../common/copy_tile
include math

fn brisc() {
    noc.read sc, score[0], n=16, wait
    cb.reserve scores
    cb.push scores
    p = cb.reserve inputs, n=2
    t = noc.read p, gate_up[slot * 2 * INTER + offset], n=part
    noc.read p + 1024, gate_up[slot * 2 * INTER + INTER + offset], n=part, tid=t
    if part < CHUNK {
        noc.read p + part, gate_up[(slot + 1) * 2 * INTER], n=CHUNK - part, tid=t
        noc.read p + 1024 + part, gate_up[(slot + 1) * 2 * INTER + INTER], n=CHUNK - part, tid=t
    }
    noc.wait t
    cb.push inputs, n=2
}

fn trisc0() {
    unpack.fmt a, in=bf16
    p = cb.wait inputs, n=2
    unpack.move a, p, dvalid
    unpack.move a, p + 1024, dvalid
    tensix.wait
    cb.pop inputs, n=2
}

// a = w * swiglu at the current address of tiles 0 (gate) and 1 (up), stored over the gate. w in l7.
macro act_step() {
    sfp.load l0, dst[dst.tile], fmt=fp32
    sfp.li l1, 1.0 / UC
    sfp.mul l0, l0, l1; sfp.nop
    tanh_l0!()
    sfp.li l1, UC
    sfp.mul l0, l0, l1; sfp.nop
    sfp.store dst[2 * dst.tile], l0, fmt=fp32     // tanh(u / UC) UC
    sfp.load l0, dst[0], fmt=fp32
    sigmoid_l0!()
    sfp.store dst[3 * dst.tile], l0, fmt=fp32     // sigmoid(g)
    sfp.load l0, dst[0], fmt=fp32
    sfp.li l1, 1.0 / GC
    sfp.mul l0, l0, l1; sfp.nop
    tanh_l0!()
    sfp.li l1, GC
    sfp.mul l0, l0, l1; sfp.nop
    sfp.load l1, dst[3 * dst.tile], fmt=fp32
    sfp.mul l0, l0, l1; sfp.nop
    sfp.load l1, dst[2 * dst.tile], fmt=fp32
    sfp.mul l0, l0, l1; sfp.nop
    sfp.mul l0, l0, l7; sfp.nop
    sfp.store dst[0], l0, fmt=fp32
    math.rwc dst+=2
}

fn trisc1() {
    math.fmt dst=fp32, sfp=fp32
    math.cfg dst_offset=0
    replay.load copy_rows
    cb.wait scores
    cb.pop scores
    sem.stall math|sfpu|sync, ready, notmax
    copy_tile!(0)
    copy_tile!(1)
    tensix.stall sfpu, math
    math.rwc reset
    // l7 = SCALE / Σ score, kept in Dst tile 4 across the macros below (exp_setup takes l4-l6).
    sfp.li l0, sc[0], fmt=fp32
    for i in 1..SLOTS {
        sfp.li l1, sc[i], fmt=fp32
        sfp.add l0, l0, l1; sfp.nop
    }
    recip_l0!()
    sfp.li l1, SCALE
    sfp.mul l0, l0, l1; sfp.nop
    // Fill tile 4 with it: the second part reads it at a nonzero Dst counter.
    loop 32 {
        sfp.store dst[4 * dst.tile], l0, fmt=fp32
        math.rwc dst+=2
    }
    math.rwc reset
    exp_setup!()
    sfp.li l7, sc[slot], fmt=fp32
    sfp.load l0, dst[4 * dst.tile], fmt=fp32
    sfp.mul l7, l7, l0; sfp.nop
    for i in 0..part / 32 { act_step!() }
    if part < CHUNK {
        sfp.li l7, sc[slot + 1], fmt=fp32
        sfp.load l0, dst[4 * dst.tile], fmt=fp32
        sfp.mul l7, l7, l0; sfp.nop
        for i in 0..(CHUNK - part) / 32 { act_step!() }
    }
    math.rwc reset
    tensix.stall sync, math|sfpu
    sem.inc ready
}

fn trisc2() {
    pack.fmt in=fp32, out=bf16
    sem.stall tdma|pack|sync, ready, nonzero
    p = cb.reserve result
    pack.move p, dst[0]
    tensix.stall sync, pack0
    tensix.wait
    cb.push result
    sem.dec ready
}

fn ncrisc() {
    r = cb.wait result
    for k in 0..CHUNK / 32 {
        o = (k / 16) * 512 + (k & 15) * 16
        l1.copy_words row + o, r + k * 32, n=8
        l1.copy_words row + o + 256, r + k * 32 + 16, n=8
    }
    noc.write output[first], row, n=CHUNK, wait
    cb.pop result
}
