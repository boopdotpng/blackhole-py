// Batched resconv.ttrv: rows of a batch step, each its own sequence (cache slot) and position from the host step table
// (see batch_attention.ttrv). Each slot keeps its ring at history[slot * HIST_SLOT ..]. DIRECT (decode: one row per
// slot) appends each active row's y to its slot's ring; else (PROMPT: consecutive positions of one slot) lags inside
// the chunk come from the earlier rows and batch_commit.ttrv appends the last rows after this launch. Workers take
// (row, page) units in turn.
//
// resconv.ttrv:
// Inkling residual-branch short convolution (reference.conv on the attention and MoE outputs) and residual add:
//   out = residual + (Σ_l w_l y[pos - l] + y) / sqrt(5)     (RESID = 0: no residual)
// y is a dense BF16 projection output; taps arrive in lag order (conv1d tap 3 is lag 0). history is a ring of four
// raw rows, history[(p % 4) * ROW] holds token p's y. One worker per 1024-channel page.
const D = 2304
const PAGES = (D + 1023) / 1024
const ROW = PAGES * 1024
const RESID = 1
const NORM = 0.4472135954999579
const ROWS = 1
const Y_STEP = ROW
const RESIDUAL_STEP = ROW
const OUT_STEP = ROW
const WORKERS = 96
const DIRECT = 1
const PROMPT = 0
const HIST_SLOT = 4 * ROW
grid WORKERS

param y: bf16[]          // [ROW], D valid
param taps: bf16[]       // [4 lags][ROW]
param history: bf16[]    // [4][ROW]
if RESID { param residual: fp32[] }
param out: fp32[]        // [ROW]
param table: u32[]          // the step table, staged in DRAM by batch_embedding.ttrv

shared { units = (ROWS * PAGES + WORKERS - 1 - core.id) / WORKERS }
l1 meta: u32[16]

cb inputs: bf16[1024], pages=8           // y, lags 1..3, weights of lags 0..3
if RESID {
    cb resid: u32[1024], pages=1
    cb loaded: u32[16], pages=1
    cb freed: u32[16], pages=1
}
cb result: fp32[1024], pages=1
sem ready = math_pack, max=1

include ../common/copy_tile

fn brisc() {
  for j in 0..units {
    u = core.id + j * WORKERS
    row = u / PAGES
    first = (u % PAGES) * 1024
    noc.read meta, table[row * 16], n=16, wait
    pos = meta[0]
    hist = meta[2] * HIST_SLOT
    p = cb.reserve inputs, n=8
    t = noc.read p, y[row * Y_STEP + first], n=1024
    for l in 1..4 {
        if PROMPT * (row >= l) {
            noc.read p + l * 1024, y[(row - l) * Y_STEP + first], n=1024, tid=t
        } else {
            if pos >= l {
                noc.read p + l * 1024, history[hist + ((pos + 4 - l) & 3) * ROW + first], n=1024, tid=t
            } else {
                z = p + l * 1024
                for i in 0..1024 { z[i] = 0.0 }
            }
        }
    }
    for l in 0..4 { noc.read p + (4 + l) * 1024, taps[l * ROW + first], n=1024, tid=t }
    noc.wait t
    if DIRECT { if meta[1] { noc.write history[hist + (pos & 3) * ROW + first], p, n=1024, wait } }
    cb.push inputs, n=8
    if RESID {
        r = cb.reserve resid
        noc.read r, residual[row * RESIDUAL_STEP + first], n=1024, wait
        cb.push resid
    }
  }
}

fn trisc0() {
  for j in 0..units {
    unpack.fmt a, in=bf16
    p = cb.wait inputs, n=8
    repeat t in 0..8 { unpack.move a, p + t * 1024, dvalid }
    tensix.wait
    cb.pop inputs, n=8
    if RESID {
        r = cb.wait resid
        cb.wait freed
        cb.pop freed
        unpack.dest r, dst[5 * dst.tile]
        cb.pop resid
        cb.reserve loaded
        cb.push loaded
    }
  }
}

fn trisc1() {
  for j in 0..units {
    math.fmt dst=fp32, sfp=fp32
    math.cfg dst_offset=0
    replay.load copy_rows
    sem.stall math|sfpu|sync, ready, notmax
    repeat t in 0..8 { copy_tile!(t) }
    tensix.stall sfpu, math
    math.rwc reset
    loop 32 {
        sfp.load l0, dst[0], fmt=fp32
        repeat l in 0..4 {
            sfp.load l1, dst[(4 + l) * dst.tile], fmt=fp32
            sfp.load l2, dst[l * dst.tile], fmt=fp32
            sfp.mad l0, l1, l2, l0; sfp.nop
        }
        sfp.li l1, NORM
        sfp.mul l0, l0, l1; sfp.nop
        sfp.store dst[4 * dst.tile], l0, fmt=fp32
        math.rwc dst+=2
    }
    math.rwc reset
    if RESID {
        tensix.wait
        cb.reserve freed
        cb.push freed
        cb.wait loaded
        cb.pop loaded
        loop 32 {
            sfp.load l0, dst[4 * dst.tile], fmt=fp32
            sfp.load l1, dst[5 * dst.tile], fmt=fp32
            sfp.add l0, l0, l1; sfp.nop
            sfp.store dst[4 * dst.tile], l0, fmt=fp32
            math.rwc dst+=2
        }
        math.rwc reset
    }
    tensix.stall sync, math|sfpu
    sem.inc ready
  }
}

fn trisc2() {
  for j in 0..units {
    pack.fmt in=fp32, out=fp32
    sem.stall tdma|pack|sync, ready, nonzero
    p = cb.reserve result
    pack.move p, dst[4 * dst.tile]
    tensix.stall sync, pack0
    tensix.wait
    cb.push result
    sem.dec ready
  }
}

fn ncrisc() {
  for j in 0..units {
    u = core.id + j * WORKERS
    r = cb.wait result
    noc.write out[(u / PAGES) * OUT_STEP + (u % PAGES) * 1024], r, n=1024, wait
    cb.pop result
  }
}
