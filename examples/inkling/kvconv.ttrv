// Inkling key/value short convolutions and normalization (reference.conv / dconv, then the cache transforms):
//   y = (Σ_l x[pos - l] (w_l + d_l[head]) + x[pos]) * NORM      l = 0..3 lags, d only on DYNAMIC (full) layers
//   k: l2clip(y, CLIP) per 128-value head;  v: y / sqrt(mean(y²) + 1e-6) per head
// Worker 0 does k, worker 1 v. Sliding layers' conv1d taps arrive in lag order (tap 3 is lag 0); NORM is 1/sqrt(5)
// for them and 1/3 for DYNAMIC layers, whose per-token taps d (KV * 4, head-major) follow the 1024 projected values.
// history: per worker a ring of four raw rows, history[(worker * 4 + p % 4) * 1024] holds token p.
const DYNAMIC = 0
const NORM = 0.4472135954999579
const CLIP = 22.627416997969522
const KV = 8             // KV heads on this card (128 values each, the rest of the page is ignored)
const TAPS_AT = KV * 128 // dynamic taps: the projection's next tile, 4 per global KV head
const TAP_BASE = 0       // this card's first global KV head
grid 2

param k_in: bf16[]       // the k projection output: [1024] (+ 32 dynamic taps)
param v_in: bf16[]
param weights: bf16[]    // [2][4 lags][1024]
param history: bf16[]    // [2][4][1024]
param k_out: bf16[]      // [1024]
param v_out: bf16[]
param pos: u32

shared {
    is_v = core.id
}

cb inputs: bf16[1024], pages=8           // x, lags 1..3, weights of lags 0..3
cb result: bf16[1024], pages=1
l1 taps: bf16[32]
sem ready = math_pack, max=1

include ../common/copy_tile
include math

fn brisc() {
    p = cb.reserve inputs, n=8
    t = noc.group read
    if is_v { noc.read p, v_in[0], n=1024, tid=t } else { noc.read p, k_in[0], n=1024, tid=t }
    if DYNAMIC {
        if is_v { noc.read taps, v_in[TAPS_AT], n=32, tid=t } else { noc.read taps, k_in[TAPS_AT], n=32, tid=t }
    }
    for l in 1..4 {
        if pos >= l {
            noc.read p + l * 1024, history[(is_v * 4 + ((pos + 4 - l) & 3)) * 1024], n=1024, tid=t
        } else {
            h = p + l * 1024
            for j in 0..1024 { h[j] = 0.0 }
        }
    }
    for l in 0..4 { noc.read p + (4 + l) * 1024, weights[(is_v * 4 + l) * 1024], n=1024, tid=t }
    noc.wait t
    noc.write history[(is_v * 4 + (pos & 3)) * 1024], p, n=1024, wait
    cb.push inputs, n=8
}

fn trisc0() {
    unpack.fmt a, in=bf16
    p = cb.wait inputs, n=8
    repeat t in 0..8 { unpack.move a, p + t * 1024, dvalid }
    tensix.wait
    cb.pop inputs, n=8
}

fn trisc1() {
    math.fmt dst=fp32, sfp=fp32
    math.cfg dst_offset=0
    replay.load copy_rows
    sem.stall math|sfpu|sync, ready, notmax
    repeat t in 0..8 { copy_tile!(t) }
    tensix.stall sfpu, math
    math.rwc reset
    // Head h is addresses 8h + {0, 2, 4, 6}.
    for h in 0..KV {
        if DYNAMIC {
            sfp.li l4, taps[(TAP_BASE + h) * 4], fmt=bf16
            sfp.li l5, taps[(TAP_BASE + h) * 4 + 1], fmt=bf16
            sfp.li l6, taps[(TAP_BASE + h) * 4 + 2], fmt=bf16
            sfp.li l7, taps[(TAP_BASE + h) * 4 + 3], fmt=bf16
        }
        loop 4 {
            sfp.load l0, dst[0], fmt=fp32                  // x
            repeat l in 0..4 {
                sfp.load l1, dst[(4 + l) * dst.tile], fmt=fp32
                if DYNAMIC {
                    if l == 0 { sfp.add l1, l1, l4; sfp.nop }
                    if l == 1 { sfp.add l1, l1, l5; sfp.nop }
                    if l == 2 { sfp.add l1, l1, l6; sfp.nop }
                    if l == 3 { sfp.add l1, l1, l7; sfp.nop }
                }
                sfp.load l2, dst[l * dst.tile], fmt=fp32
                sfp.mad l0, l1, l2, l0; sfp.nop
            }
            sfp.li l1, NORM
            sfp.mul l0, l0, l1; sfp.nop
            sfp.store dst[4 * dst.tile], l0, fmt=fp32      // y over the lag 0 weights
            math.rwc dst+=2
        }
    }
    math.rwc reset
    loop KV {
        sfp.li l0, 0.0
        repeat i in 0..4 {
            sfp.load l1, dst[4 * dst.tile + 2 * i], fmt=fp32
            sfp.mad l0, l1, l1, l0; sfp.nop
        }
        reduce_lanes!()
        if is_v {
            sfp.li l1, 1.0 / 128
            sfp.li l2, 1e-6
            sfp.mad l0, l0, l1, l2; sfp.nop
            rsqrt_l0!()
        } else {
            sfp.li l1, 1e-30
            sfp.add l0, l0, l1; sfp.nop
            sfp.mov l7, l0
            rsqrt_l0!()
            sfp.mul l0, l0, l7; sfp.nop
            sfp.li l1, 1e-6
            sfp.add l0, l0, l1; sfp.nop
            recip_l0!()
            sfp.li l1, CLIP
            sfp.mul l0, l0, l1; sfp.nop
            sfp.minmax l0, one
        }
        repeat i in 0..4 {
            sfp.load l1, dst[4 * dst.tile + 2 * i], fmt=fp32
            sfp.mul l1, l1, l0; sfp.nop
            sfp.store dst[4 * dst.tile + 2 * i], l1, fmt=fp32
        }
        math.rwc dst+=8
    }
    math.rwc reset
    tensix.stall sync, math|sfpu
    sem.inc ready
}

fn trisc2() {
    pack.fmt in=fp32, out=bf16
    sem.stall tdma|pack|sync, ready, nonzero
    p = cb.reserve result
    pack.move p, dst[4 * dst.tile]
    tensix.stall sync, pack0
    tensix.wait
    cb.push result
    sem.dec ready
}

fn ncrisc() {
    r = cb.wait result
    if is_v { noc.write v_out[0], r, n=1024, wait } else { noc.write k_out[0], r, n=1024, wait }
    cb.pop result
}
