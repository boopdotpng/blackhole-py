// Inkling attention preparation in one launch: qprep.ttrv, kvconv.ttrv and rel.ttrv side by side on disjoint workers.
//   q workers (0 .. Q_PAGES - 1): q = l2clip(q * q_scale, Q_CLIP) / sqrt(HEAD_DIM) per 128-value head, a page each
//   k, v workers (Q_PAGES, Q_PAGES + 1): the short convolution and normalization of kvconv.ttrv
//   r workers (the next RW): r = l2clip(r * r_scale, R_CLIP) per 16-value head (every r worker computes it), then
//     rel[h, d] = Σ_r r[h, r] P[r, d] for its EXTENT / 32 / RW tiles of 32 distances (the matrix unit, as rel.ttrv)
// See those kernels for the formats. The clipped r page is one Dst tile whose row h is head h (16 values, columns
// 0..15); heads 16.. move to tile rows 16.. (Dst rows 32..) so it is the left operand of the products.
const HEAD_DIM = 128
const H = 24
const Q_PAGES = (H * HEAD_DIM + 1023) / 1024
const R_PAGE = 2 * H * HEAD_DIM / 1024
const Q_CLIP = 22.627416997969522
const R_CLIP = 8.0
const DYNAMIC = 0
const NORM = 0.4472135954999579
const CLIP = 22.627416997969522
const KV = 8
const TAPS_AT = KV * 128
const TAP_BASE = 0
const EXTENT = 1024
const RW = 32
const RT = EXTENT / 32 / RW
const KVW = Q_PAGES
const RW0 = Q_PAGES + 2
grid Q_PAGES + 2 + RW

param proj: bf16[]       // the q projection output
param q_scale: bf16[]    // [Q_PAGES * 1024]
param r_scale: bf16[]    // [1024]: H * 16 valid, zeros after
param q_out: bf16[]      // [Q_PAGES * 1024]
param k_in: bf16[]
param v_in: bf16[]
param weights: bf16[]    // [2][4 lags][1024]
param history: bf16[]    // [2][4][1024]
param k_out: bf16[]
param v_out: bf16[]
param proj_tiles: bf16[] // [EXTENT / 32][1024]
param rel: bf16[]        // [H][EXTENT]
param pos: u32

shared {
    is_q = core.id < KVW
    is_v = core.id == KVW + 1
    is_kv = (core.id >= KVW) * (core.id < RW0)
    rw = core.id - RW0
    first_tile = rw * RT
}

cb inputs: bf16[1024], pages=8           // q: page, scale; kv: x, lags 1..3, weights of lags 0..3; r: page, scale
cb result: bf16[1024], pages=2
cb ptiles: bf16[1024], pages=RT
cb rtile: bf16[1024], pages=1
l1 taps: bf16[32]
l1 lines: bf16[H * 32]
sem ready = math_pack, max=1

const PHASES = 2
include ../common/matmul_phases
include ../common/copy_tile
include math

// l0 = min(clip / (sqrt(l0) + 1e-6), 1) * post for the sum of squares in l0. Clobbers l1-l3, l7.
macro clip_factor(clip, post) {
    sfp.li l1, 1e-30
    sfp.add l0, l0, l1; sfp.nop
    sfp.mov l7, l0
    rsqrt_l0!()
    sfp.mul l0, l0, l7; sfp.nop          // sqrt
    sfp.li l1, 1e-6
    sfp.add l0, l0, l1; sfp.nop
    recip_l0!()
    sfp.li l1, clip
    sfp.mul l0, l0, l1; sfp.nop
    sfp.minmax l0, one                   // l0 = min(l0, 1)
    sfp.li l1, post
    sfp.mul l0, l0, l1; sfp.nop
}

fn brisc() {
    p = cb.reserve inputs, n=8
    t = noc.group read
    if is_q {
        noc.read p, proj[core.id * 1024], n=1024, tid=t
        noc.read p + 1024, q_scale[core.id * 1024], n=1024, tid=t
    }
    if is_kv {
        if is_v { noc.read p, v_in[0], n=1024, tid=t } else { noc.read p, k_in[0], n=1024, tid=t }
        if DYNAMIC {
            if is_v { noc.read taps, v_in[TAPS_AT], n=32, tid=t } else { noc.read taps, k_in[TAPS_AT], n=32, tid=t }
        }
        for l in 1..4 {
            if pos >= l {
                noc.read p + l * 1024, history[(is_v * 4 + ((pos + 4 - l) & 3)) * 1024], n=1024, tid=t
            } else {
                h = p + l * 1024
                for j in 0..1024 { h[j] = 0.0 }
            }
        }
        for l in 0..4 { noc.read p + (4 + l) * 1024, weights[(is_v * 4 + l) * 1024], n=1024, tid=t }
    }
    if core.id >= RW0 {
        noc.read p, proj[R_PAGE * 1024], n=1024, tid=t
        noc.read p + 1024, r_scale[0], n=1024, tid=t
        w = cb.reserve ptiles, n=RT
        noc.read w, proj_tiles[first_tile * 1024], n=RT * 1024, tid=t
        noc.wait t
        cb.push ptiles, n=RT
    } else { noc.wait t }
    if is_kv { noc.write history[(is_v * 4 + (pos & 3)) * 1024], p, n=1024, wait }
    cb.push inputs, n=8
}

fn trisc0() {
    unpack.fmt a, in=bf16
    p = cb.wait inputs, n=8
    if is_kv { repeat t in 0..8 { unpack.move a, p + t * 1024, dvalid } } else {
        unpack.move a, p, dvalid
        unpack.move a, p + 1024, dvalid
    }
    tensix.wait
    cb.pop inputs, n=8
    if core.id >= RW0 {
        rt = cb.wait rtile
        w = cb.wait ptiles, n=RT
        unpack.fmt a|b, in=bf16
        for i in 0..RT {
            unpack.move b, rt, dvalid
            unpack.move a, w + i * 1024, dvalid
        }
        tensix.wait
        cb.pop ptiles, n=RT
        cb.pop rtile
    }
}

macro mul_scale() {
    copy_tile!(0)
    copy_tile!(1)
    tensix.stall sfpu, math
    math.rwc reset
    loop 32 {
        sfp.load l0, dst[0], fmt=fp32
        sfp.load l1, dst[dst.tile], fmt=fp32
        sfp.mul l0, l0, l1; sfp.nop
        sfp.store dst[0], l0, fmt=fp32
        math.rwc dst+=2
    }
    math.rwc reset
}

fn trisc1() {
    math.fmt dst=fp32, sfp=fp32
    math.cfg dst_offset=0
    replay.load copy_rows
    sem.stall math|sfpu|sync, ready, notmax
    if is_q {
        mul_scale!()
        // Per head: addresses 8h + {0, 2, 4, 6}.
        loop 8 {
            sfp.li l0, 0.0
            repeat i in 0..4 {
                sfp.load l1, dst[2 * i], fmt=fp32
                sfp.mad l0, l1, l1, l0; sfp.nop
            }
            reduce_lanes!()
            clip_factor!(Q_CLIP, 1.0 / sqrt(HEAD_DIM))
            repeat i in 0..4 {
                sfp.load l1, dst[2 * i], fmt=fp32
                sfp.mul l1, l1, l0; sfp.nop
                sfp.store dst[2 * i], l1, fmt=fp32
            }
            math.rwc dst+=8
        }
        math.rwc reset
        tensix.stall sync, math|sfpu
        sem.inc ready
    }
    if is_kv {
        repeat t in 0..8 { copy_tile!(t) }
        tensix.stall sfpu, math
        math.rwc reset
        for h in 0..KV {
            if DYNAMIC {
                sfp.li l4, taps[(TAP_BASE + h) * 4], fmt=bf16
                sfp.li l5, taps[(TAP_BASE + h) * 4 + 1], fmt=bf16
                sfp.li l6, taps[(TAP_BASE + h) * 4 + 2], fmt=bf16
                sfp.li l7, taps[(TAP_BASE + h) * 4 + 3], fmt=bf16
            }
            loop 4 {
                sfp.load l0, dst[0], fmt=fp32                  // x
                repeat l in 0..4 {
                    sfp.load l1, dst[(4 + l) * dst.tile], fmt=fp32
                    if DYNAMIC {
                        if l == 0 { sfp.add l1, l1, l4; sfp.nop }
                        if l == 1 { sfp.add l1, l1, l5; sfp.nop }
                        if l == 2 { sfp.add l1, l1, l6; sfp.nop }
                        if l == 3 { sfp.add l1, l1, l7; sfp.nop }
                    }
                    sfp.load l2, dst[l * dst.tile], fmt=fp32
                    sfp.mad l0, l1, l2, l0; sfp.nop
                }
                sfp.li l1, NORM
                sfp.mul l0, l0, l1; sfp.nop
                sfp.store dst[4 * dst.tile], l0, fmt=fp32      // y over the lag 0 weights
                math.rwc dst+=2
            }
        }
        math.rwc reset
        loop KV {
            sfp.li l0, 0.0
            repeat i in 0..4 {
                sfp.load l1, dst[4 * dst.tile + 2 * i], fmt=fp32
                sfp.mad l0, l1, l1, l0; sfp.nop
            }
            reduce_lanes!()
            if is_v {
                sfp.li l1, 1.0 / 128
                sfp.li l2, 1e-6
                sfp.mad l0, l0, l1, l2; sfp.nop
                rsqrt_l0!()
            } else {
                sfp.li l1, 1e-30
                sfp.add l0, l0, l1; sfp.nop
                sfp.mov l7, l0
                rsqrt_l0!()
                sfp.mul l0, l0, l7; sfp.nop
                sfp.li l1, 1e-6
                sfp.add l0, l0, l1; sfp.nop
                recip_l0!()
                sfp.li l1, CLIP
                sfp.mul l0, l0, l1; sfp.nop
                sfp.minmax l0, one
            }
            repeat i in 0..4 {
                sfp.load l1, dst[4 * dst.tile + 2 * i], fmt=fp32
                sfp.mul l1, l1, l0; sfp.nop
                sfp.store dst[4 * dst.tile + 2 * i], l1, fmt=fp32
            }
            math.rwc dst+=8
        }
        math.rwc reset
        // The result goes out from tile 0.
        loop 32 {
            sfp.load l0, dst[4 * dst.tile], fmt=fp32
            sfp.store dst[0], l0, fmt=fp32
            math.rwc dst+=2
        }
        math.rwc reset
        tensix.stall sync, math|sfpu
        sem.inc ready
    }
    if core.id >= RW0 {
        mul_scale!()
        // Per Dst row (one head): the even and odd column sums of squares.
        loop 16 {
            sfp.load l0, dst[0], fmt=fp32
            sfp.mul l0, l0, l0; sfp.nop
            row_sum_l0!()
            sfp.mov l6, l0
            sfp.load l0, dst[2], fmt=fp32
            sfp.mul l0, l0, l0; sfp.nop
            row_sum_l0!()
            sfp.add l0, l0, l6; sfp.nop
            clip_factor!(R_CLIP, 1.0)
            sfp.load l1, dst[0], fmt=fp32
            sfp.mul l1, l1, l0; sfp.nop
            sfp.store dst[0], l1, fmt=fp32
            sfp.load l1, dst[2], fmt=fp32
            sfp.mul l1, l1, l0; sfp.nop
            sfp.store dst[2], l1, fmt=fp32
            math.rwc dst+=4
        }
        math.rwc reset
        if H > 16 {
            // Heads 16..31 (Dst rows 16..31, face 1) to tile rows 16..31 (Dst rows 32..47, face 2).
            sfp.li l2, 0.0
            repeat a in 0..8 {
                sfp.load l1, dst[16 + 2 * a], fmt=fp32
                sfp.store dst[32 + 2 * a], l1, fmt=fp32
                sfp.store dst[16 + 2 * a], l2, fmt=fp32
            }
        }
        tensix.stall sync, math|sfpu
        sem.inc ready
        // The products, one output tile each.
        math.addrmod mm_k, slot=1, srca+=16, srcb=cr+0, dst+=8
        math.addrmod mm_col, slot=2, srca=cr+0, srcb=cr+32, dst+=8
        math.addrmod mm_b, slot=3, srcb+=8, dst+=8
        math.addrmod mm_row, slot=4, srca=cr+32, srcb=cr+48, dst=cr+0
        math.addrmod mm_phase, slot=5, srca=0, srcb=0, dst=0, fidelity+=1
        replay.load mm_first
        replay.load mm_second
        mop.load matmul
        for i in 0..RT {
            sem.stall math|sfpu|sync, ready, notmax
            repeat face in 0..4 { math.zero face=face, fmt=fp32 }
            math.rwc reset
            tensix.stall math, srca_vld|srcb_vld
            mop.run matmul
            math.rwc reset, release=b
            tensix.stall sync, math
            sem.inc ready
        }
    }
}

fn trisc2() {
    pack.fmt in=fp32, out=bf16
    sem.stall tdma|pack|sync, ready, nonzero
    if core.id >= RW0 {
        r = cb.reserve rtile
        pack.move r, dst[0]
        tensix.stall sync, pack0
        tensix.wait
        cb.push rtile
        sem.dec ready
        for i in 0..RT {
            sem.stall tdma|pack|sync, ready, nonzero
            p = cb.reserve result
            pack.move p, dst[0]
            tensix.stall sync, pack0
            tensix.wait
            cb.push result
            sem.dec ready
        }
    } else {
        p = cb.reserve result
        pack.move p, dst[0]
        tensix.stall sync, pack0
        tensix.wait
        cb.push result
        sem.dec ready
    }
}

fn ncrisc() {
    if core.id >= RW0 {
        for i in 0..RT {
            o = cb.wait result
            w = noc.group write
            for h in 0..H {
                at = (h / 16) * 512 + (h & 15) * 16
                line = lines + h * 32
                l1.copy_words line, o + at, n=8
                l1.copy_words line + 16, o + at + 256, n=8
                noc.write rel[h * EXTENT + (first_tile + i) * 32], line, n=32, tid=w
            }
            noc.wait w
            cb.pop result
        }
    } else {
        r = cb.wait result
        if is_q { noc.write q_out[core.id * 1024], r, n=1024, wait } else {
            if is_v { noc.write v_out[0], r, n=1024, wait } else { noc.write k_out[0], r, n=1024, wait }
        }
        cb.pop result
    }
}
