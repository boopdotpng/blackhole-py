// Copy N FP32 elements from src to dst and dst2 (whole 1024-element pages, one per worker).
const N = 6144
grid N / 1024

param src: fp32[]
param dst: fp32[]
param dst2: fp32[]

l1 page: fp32[1024]

fn brisc() {
    noc.read page, src[core.id * 1024], n=1024, wait
    t = noc.write dst[core.id * 1024], page, n=1024
    noc.write dst2[core.id * 1024], page, n=1024, tid=t
    noc.wait t
}
