// Grouped routed experts, steps 3 and 4: each group's 32-row activation tiles times its expert's matrix, every weight
// tile read once per group. Weight images as experts.ttrv's (every expert's image back to back, EXPERT_TILES each).
// SWIGLU (gate/up): a unit is one output tile column c of the expert's intermediate: gate column c and up column
// NU + c, then tanh(g / GC) GC sigmoid(g) tanh(u / UC) UC on the whole tile, written as tile c of the group's
// down-projection input (output[g][NU tiles]). Else (down): a unit is one output column tile, whose rows go to the
// group's entries' y rows (output[32 g + i], YS apart, i below the group's count). The routing weights are applied
// by moe_combine.ttrv. Units (g, c) are numbered g * NU + c; worker w takes a contiguous range of the G * NU of this
// step (G from moe_plan.ttrv), so it loads few groups' activations. BRISC reads the plan and bumps `ready`; the other
// RISCs wait for it to move past the count they saw last launch (as batch_attention.ttrv).
const SWIGLU = 1
const K = 2304
const N = 2304          // one expert's image width
const BITS = 8
const GROUP = 8
const BATCH = 24
const PAD = 1
const G_MAX = 144
const P_EXPERT = 16
const P_COUNT = P_EXPERT + G_MAX
const YS = 3072
const GC = 4.0
const UC = 25.0
const WORKERS = 128
grid WORKERS
if BITS == 4 { type W = bfp4 } else { if BITS == 8 { type W = bfp8 } else { type W = bf16 } }

param x: bf16[]           // per group: K / 32 tiles of 32 activation rows
param weights: W[], tiles_per_page=GROUP
param plan: u32[]
param output: bf16[]

const KT = K / 32
const NT = N / 32
const PITCH = NT + PAD * (1 - NT % 2)
const EXPERT_TILES = KT / GROUP * PITCH * GROUP
const COLS = 1 + SWIGLU
const NU = NT / COLS
const BLOCKS = KT / BATCH
const PORT_WORKERS = 8
shared { port_id = core.id / PORT_WORKERS % 3 }

l1 meta: u32[16]
l1 experts: u32[G_MAX]
l1 counts: u32[G_MAX]
l1 line: bf16[32]
l1 ready: u32[4], keep
l1 seen0: u32[4], keep
l1 seen1: u32[4], keep
l1 seen2: u32[4], keep
l1 seen3: u32[4], keep
cb activations: bf16[KT * 1024], pages=2
cb matrices: W[1024], pages=2 * BATCH
cb results: bf16[1024], pages=2
sem done = math_pack, max=1

const PHASES = 2 - (BITS == 4)
include ../common/matmul_phases
include math

macro await_plan(seen) {
    loop { if ready[0] != seen[0] { break }; fence }
    seen[0] = ready[0]
}

// a = tanh(g / GC) GC sigmoid(g) tanh(u / UC) UC at the current address of tiles 0 (gate) and 1 (up), over the gate.
macro swiglu_step() {
    sfp.load l0, dst[dst.tile], fmt=fp32
    sfp.li l1, 1.0 / UC
    sfp.mul l0, l0, l1; sfp.nop
    tanh_l0!()
    sfp.li l1, UC
    sfp.mul l0, l0, l1; sfp.nop
    sfp.store dst[2 * dst.tile], l0, fmt=fp32     // tanh(u / UC) UC
    sfp.load l0, dst[0], fmt=fp32
    sigmoid_l0!()
    sfp.store dst[3 * dst.tile], l0, fmt=fp32     // sigmoid(g)
    sfp.load l0, dst[0], fmt=fp32
    sfp.li l1, 1.0 / GC
    sfp.mul l0, l0, l1; sfp.nop
    tanh_l0!()
    sfp.li l1, GC
    sfp.mul l0, l0, l1; sfp.nop
    sfp.load l1, dst[3 * dst.tile], fmt=fp32
    sfp.mul l0, l0, l1; sfp.nop
    sfp.load l1, dst[2 * dst.tile], fmt=fp32
    sfp.mul l0, l0, l1; sfp.nop
    sfp.store dst[0], l0, fmt=fp32
    math.rwc dst+=2
}

fn brisc() {
    t = noc.read meta, plan[0], n=16
    noc.read experts, plan[P_EXPERT], n=G_MAX, tid=t
    noc.wait t
    fence
    ready[0] = ready[0] + 1
    total = meta[0] * NU
    for u in core.id * total / WORKERS..(core.id + 1) * total / WORKERS {
        base = experts[u / NU] * EXPERT_TILES
        for h in 0..COLS {
            col = u % NU + h * NU
            for bl in 0..BLOCKS {
                w = cb.reserve matrices, n=BATCH
                tile = base + ((bl * (BATCH / GROUP)) * PITCH + col) * GROUP
                r = noc.read w, tileptr(weights, tile), port=port_id, n=GROUP * 1024
                for i in 1..BATCH / GROUP {
                    noc.read tileptr(w, i * GROUP), tileptr(weights, tile + i * PITCH * GROUP), port=port_id, n=GROUP * 1024, tid=r
                }
                noc.wait r
                cb.push matrices, n=BATCH
            }
        }
    }
}

fn trisc0() {
    await_plan!(seen0)
    total = meta[0] * NU
    lo = core.id * total / WORKERS
    hi = (core.id + 1) * total / WORKERS
    unpack.fmt a, in=W
    unpack.fmt b, in=bf16
    if BITS == 16 { unpack.shape a, n=1024, faces=1 } else { unpack.shape a, n=256, faces=4 }
    unpack.shape b, n=1024, faces=1
    for u in lo..hi {
        act = cb.wait activations
        for h in 0..COLS {
            for bl in 0..BLOCKS {
                w = cb.wait matrices, n=BATCH
                // 32-row activation tiles step by one tile per Z; BFP weight tiles carry their own exponents, so
                // their base is written per tile (as projection.ttrv's prompt path).
                unpack.base b, act + bl * BATCH * 1024, stream
                if BITS == 16 { unpack.base a, w, stream }
                unpack.reset_zw a|b
                for i in 0..BATCH {
                    if BITS != 16 {
                        unpack.base a, tileptr(w, i), stream
                        unpack.reset_zw a
                    }
                    tensix.stall unpack, srca_clr|srcb_clr
                    unpack.face b, next_l1_face, dvalid
                    if BITS == 16 { unpack.face a, next_l1_face, dvalid } else {
                        repeat 3 { unpack.face a, next_tile_face }
                        unpack.face a, next_tile_face, dvalid
                    }
                }
                tensix.stall sync, unpack0|unpack1
                tensix.wait
                cb.pop matrices, n=BATCH
            }
        }
        if u + 1 == hi || (u + 1) % NU == 0 { cb.pop activations }
    }
}

fn trisc1() {
    await_plan!(seen1)
    total = meta[0] * NU
    lo = core.id * total / WORKERS
    hi = (core.id + 1) * total / WORKERS
    math.fmt dst=fp32, sfp=fp32
    math.cfg dst_offset=0
    math.addrmod mm_k, slot=1, srca+=16, srcb=cr+0, dst+=8
    math.addrmod mm_col, slot=2, srca=cr+0, srcb=cr+32, dst+=8
    math.addrmod mm_b, slot=3, srcb+=8, dst+=8
    math.addrmod mm_row, slot=4, srca=cr+32, srcb=cr+48, dst=cr+0
    math.addrmod mm_phase, slot=5, srca=0, srcb=0, dst=0, fidelity+=1
    replay.load mm_first
    replay.load mm_second
    mop.load matmul
    for u in lo..hi {
        for h in 0..COLS {
            if h == 0 {
                sem.stall math|sync, done, notmax
                repeat face in 0..4 { math.zero face=face, fmt=fp32 }
            } else {
                math.cfg dst_offset=dst.tile
                repeat face in 4..8 { math.zero face=face, fmt=fp32 }    // faces count from Dst row 0
            }
            for k in 0..KT {
                math.rwc reset
                tensix.stall math, srca_vld|srcb_vld
                mop.run matmul
                math.rwc reset, release=b
            }
            tensix.stall sync, math
        }
        if SWIGLU {
            math.cfg dst_offset=0
            exp_setup!()
            math.rwc reset
            loop 32 { swiglu_step!() }
            math.rwc reset
            tensix.stall sync, math|sfpu
        }
        sem.inc done
    }
}

fn trisc2() {
    await_plan!(seen2)
    total = meta[0] * NU
    pack.fmt in=fp32, out=bf16
    for u in core.id * total / WORKERS..(core.id + 1) * total / WORKERS {
        sem.stall tdma|pack|sync, done, nonzero
        p = cb.reserve results
        pack.move p, dst[0]
        tensix.stall sync, pack0
        tensix.wait
        cb.push results
        sem.dec done
    }
}

fn ncrisc() {
    await_plan!(seen3)
    if SWIGLU == 0 { noc.read counts, plan[P_COUNT], n=G_MAX, wait }
    total = meta[0] * NU
    lo = core.id * total / WORKERS
    hi = (core.id + 1) * total / WORKERS
    for u in lo..hi {
        g = u / NU
        c = u % NU
        if u == lo || c == 0 {
            a = cb.reserve activations
            noc.read a, x[g * KT * 1024], n=KT * 1024, wait
            cb.push activations
        }
        p = cb.wait results
        if SWIGLU { noc.write output[(g * NU + c) * 1024], p, n=1024, wait } else {
            for i in 0..counts[g] {
                src = p + (i / 16) * 512 + (i % 16) * 16
                l1.copy_words line, src, n=8
                l1.copy_words line + 16, src + 256, n=8
                noc.write output[(g * 32 + i) * YS + c * 32], line, n=32, wait
            }
        }
        cb.pop results
    }
}
