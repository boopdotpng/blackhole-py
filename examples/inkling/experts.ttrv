// Decode projection y = W x (the decode path of examples/nanbeige/projection.ttrv) for Inkling's router and experts.
// x is BF16 face-packed (in each 512-element block, the low 16 of every 32 values, then the high 16), padded to a
// multiple of 512; y is a dense row. Each worker owns whole 32-column output tiles.
//
// Weight images (examples/inkling/repack.py): page (k group g, column c) is page g * PITCH + c, GROUP K tiles each.
// SELECT = 1: N = SLOTS image widths; output slot s reads expert select[s]'s image (gate/up of the routed experts).
// SELECT = 2: K = SLOTS image depths; K slot s reads expert select[s]'s image (their down projections, summed).
// Every expert image is EXPERT_TILES tiles; weights holds all of a layer's experts back to back. select holds
// router.ttrv's FP32 id + 2^23 words, whose low byte is the expert id.
const WORKERS = 96
const ROWS = 1
const X_STRIDE = 0
const OUT_STRIDE = 0
grid WORKERS * ROWS
const K = 2304
const N = 2304
const BITS = 8
const GROUP = 8
const STREAM_UNPACK = 0
const BATCH = GROUP
const PAD = 1
const OUT32 = 0
const SELECT = 0
const SLOTS = 8
const X2 = 0           // x holds the first K / 2 inputs and x2 the rest, each padded as x
const PACK_OUT = 0     // write the output face-packed (the next projection's input order)
const SPLIT = 1        // K split: worker (split, column worker) sums K tiles [split, split + 1) * KT / SPLIT and
                       // writes its partial at output[split * SPLIT_STRIDE ..]
const SPLIT_STRIDE = 512
const GROUP_NT = 0     // > 0: output columns come in groups of GROUP_NT, group g reading activation tiles shifted by
const KSHIFT = 0       // g * KSHIFT (several small projections with their own inputs in one launch)
const XROW = 0         // X2 with groups: group g's x is x[g * XROW ..], its x2 is x2[g * X2ROW ..]
const X2ROW = 0
const SEG1 = 0         // > 0: output columns [0, SEG1) go to output, [SEG1, SEG2) to output2, the rest to output3
const SEG2 = 0
const XSEG = 0         // with segments: segment s reads input row x[s * XROW ..] (else every segment reads x)
const WAIT = 0         // > 0: x is ready once flag holds token in the first word of each of WAIT 64-byte slots (written
                       // by an async producer launch, see const CORE_BASE and Kernel(_async=True))
const SWIGLU = 0       // SELECT = 1 gate/up: a worker takes (gate, up) column pairs of one expert slot and writes
                       // w_s tanh(g / GC) GC sigmoid(g) tanh(u / UC) UC face-packed (the down projection's input),
                       // w_s = score_s / Σ score * SCALE (swiglu.ttrv in the epilogue)
const GC = 4.0
const UC = 25.0
const SCALE = 8.0
const POLL_BACKOFF = 32  // fences between flag polls
const PREFETCH = 0     // the weight CB holds all of a worker's tiles, so they stream in while x is awaited
const SUMS = 1         // x holds SUMS partial input vectors (each K, padded like x, back to back): y = W Σ_s x_s,
                       // each weight tile multiplied by every partial (the reduction rides the matrix unit's K sum)
if BITS == 4 { type W = bfp4 } else { if BITS == 8 { type W = bfp8 } else { type W = bf16 } }

param x: bf16[]
param weights: W[], tiles_per_page=GROUP
if OUT32 { param output: fp32[] } else { param output: bf16[] }
if SELECT { param select: u32[] }
if SWIGLU { param score: fp32[] }
if WAIT {
    param flag: u32[]
    param token: u32
}
if X2 { param x2: bf16[] }
if SEG1 {
    param output2: bf16[]
    param output3: bf16[]
}

const KT = K / 32
const NT = N / 32
const X_TAIL = (512 - K % 512) % 512
const XS = K + X_TAIL
const BLOCKS = KT / BATCH / SPLIT       // per worker
const COLW = WORKERS / SPLIT
const NGROUPS = NT / (GROUP_NT + (GROUP_NT == 0) * NT)
const GNT = GROUP_NT + (GROUP_NT == 0) * NT
const NSEG = 1 + 2 * XSEG
const ACT = X2 * NGROUPS * K + (1 - X2) * SUMS * XS * NSEG
const IMAGE_KT = KT / (1 + (SLOTS - 1) * (SELECT == 2))
const IMAGE_NT = NT / (1 + (SLOTS - 1) * (SELECT == 1))
const IMAGE_BLOCKS = IMAGE_KT / BATCH
const PITCH = IMAGE_NT + PAD * (1 - IMAGE_NT % 2)
const EXPERT_TILES = IMAGE_KT / GROUP * PITCH * GROUP
const PORT_WORKERS = 8
const MAXCOUNT = (NT + COLW - 1) / COLW
const INTER_T = IMAGE_NT / 2                 // SWIGLU: gate tiles per slot (the up tiles follow)
const NPAIRS = SLOTS * INTER_T
shared {
    port_id = core.id / PORT_WORKERS % 3
    row = core.id / WORKERS
    part = (core.id % WORKERS) / COLW
    first_col = (core.id % WORKERS) % COLW
    col_step = COLW
    count = (1 - SWIGLU) * ((NT + COLW - 1 - first_col) / COLW) + SWIGLU * 2 * ((NPAIRS + COLW - 1 - first_col) / COLW)
    first_block = part * BLOCKS
    xg_lo = (first_col / GNT) * (COLW >= NT)    // X2 groups this worker reads: its own when it has one column
    xg_hi = xg_lo + 1 + (NGROUPS - 1) * (COLW < NT)
}
if SELECT { l1 chosen: u32[16] }
if SWIGLU {
    l1 sc: fp32[16]
    cb scores: u32[16], pages=1
}
if OUT32 { l1 line: fp32[32] } else { l1 line: bf16[32] }
if PACK_OUT { l1 packed: bf16[512], align=1024 }
cb activations: bf16[ACT + 1024], pages=1
cb matrices: W[1024], pages=PREFETCH * MAXCOUNT * BLOCKS * BATCH + (1 - PREFETCH) * 2 * BATCH
if WAIT { l1 flags: u32[WAIT * 16] }
if OUT32 { cb results: fp32[1024], pages=2 } else { cb results: bf16[1024], pages=2 }
sem ready = math_pack, max=1

const PHASES = 2 - (BITS == 4)
include ../common/matmul_phases
include math

// a = w * swiglu at the current address of tiles 0 (gate) and 1 (up), stored over the gate. w in l7.
macro swiglu_step() {
    sfp.load l0, dst[dst.tile], fmt=fp32
    sfp.li l1, 1.0 / UC
    sfp.mul l0, l0, l1; sfp.nop
    tanh_l0!()
    sfp.li l1, UC
    sfp.mul l0, l0, l1; sfp.nop
    sfp.store dst[2 * dst.tile], l0, fmt=fp32     // tanh(u / UC) UC
    sfp.load l0, dst[0], fmt=fp32
    sigmoid_l0!()
    sfp.store dst[3 * dst.tile], l0, fmt=fp32     // sigmoid(g)
    sfp.load l0, dst[0], fmt=fp32
    sfp.li l1, 1.0 / GC
    sfp.mul l0, l0, l1; sfp.nop
    tanh_l0!()
    sfp.li l1, GC
    sfp.mul l0, l0, l1; sfp.nop
    sfp.load l1, dst[3 * dst.tile], fmt=fp32
    sfp.mul l0, l0, l1; sfp.nop
    sfp.load l1, dst[2 * dst.tile], fmt=fp32
    sfp.mul l0, l0, l1; sfp.nop
    sfp.mul l0, l0, l7; sfp.nop
    sfp.store dst[0], l0, fmt=fp32
    math.rwc dst+=2
}

fn brisc() {
    if SELECT { noc.read chosen, select[row * 1024], n=16, wait }
    if SWIGLU {
        noc.read sc, score[row * 1024], n=16, wait
        cb.reserve scores
        cb.push scores
    }
    for j in 0..count {
        col = first_col + j * col_step
        if SWIGLU {
            pr = first_col + (j / 2) * COLW
            col = (pr / INTER_T) * IMAGE_NT + pr % INTER_T + (j & 1) * INTER_T
        }
        image_col = col
        base = 0
        if SELECT == 1 {
            image_col = col % IMAGE_NT
            base = (chosen[col / IMAGE_NT] & 255) * EXPERT_TILES
        }
        for bl in 0..BLOCKS {
            block = first_block + bl
            image_block = block
            if SELECT == 2 {
                image_block = block % IMAGE_BLOCKS
                base = (chosen[block / IMAGE_BLOCKS] & 255) * EXPERT_TILES
            }
            w = cb.reserve matrices, n=BATCH
            tile = base + ((image_block * (BATCH / GROUP)) * PITCH + image_col) * GROUP
            r = noc.read w, tileptr(weights, tile), port=port_id, n=GROUP * 1024
            for i in 1..BATCH / GROUP {
                noc.read tileptr(w, i * GROUP), tileptr(weights, tile + i * PITCH * GROUP), port=port_id, n=GROUP * 1024, tid=r
            }
            noc.wait r
            cb.push matrices, n=BATCH
        }
    }
}

fn trisc0() {
    unpack.fmt a, in=W
    unpack.fmt b, in=bf16
    if BITS == 16 { unpack.shape a, n=1024, faces=1 } else { unpack.shape a, n=256, faces=4 }
    unpack.shape b, n=1024, faces=1
    a = cb.wait activations
    for j in 0..count {
        jc = first_col + j * col_step
        shift = (jc / GNT) * KSHIFT
        if XSEG { shift = ((jc >= SEG1) + (jc >= SEG2)) * (XS / 32) }
        for bl in 0..BLOCKS {
            w = cb.wait matrices, n=BATCH
            for ii in 0..BATCH * SUMS {
                i = ii / SUMS
                k = (first_block + bl) * BATCH + i + shift
                if STREAM_UNPACK {
                    unpack.base b, a + (ii % SUMS) * XS + (k / 16) * 512 + (k & 15) * 16, stream
                    unpack.base a, tileptr(w, i), stream
                } else {
                    unpack.acquire
                    unpack.base b, a + (ii % SUMS) * XS + (k / 16) * 512 + (k & 15) * 16
                    unpack.base a, tileptr(w, i)
                    unpack.post
                }
                tensix.stall unpack, srca_clr|srcb_clr
                unpack.reset_zw a|b
                if STREAM_UNPACK == 0 { tensix.stall unpack, trisc_cfg }
                unpack.face b, dvalid
                if BITS == 16 { unpack.face a, dvalid } else {
                    repeat 3 { unpack.face a, next_tile_face }
                    unpack.face a, next_tile_face, dvalid
                }
                if STREAM_UNPACK == 0 { tensix.stall sync, unpack0|unpack1; unpack.release }
            }
            if STREAM_UNPACK { tensix.stall sync, unpack0|unpack1 }
            tensix.wait
            cb.pop matrices, n=BATCH
        }
    }
    cb.pop activations
}

fn trisc1() {
    math.fmt dst=fp32, sfp=fp32
    math.cfg dst_offset=0
    math.addrmod mm_k, slot=1, srca+=16, srcb=cr+0, dst+=8
    math.addrmod mm_col, slot=2, srca=cr+0, srcb=cr+32, dst+=8
    math.addrmod mm_b, slot=3, srcb+=8, dst+=8
    math.addrmod mm_row, slot=4, srca=cr+32, srcb=cr+48, dst=cr+0
    math.addrmod mm_phase, slot=5, srca=0, srcb=0, dst=0, fidelity+=1
    replay.load mm_first
    replay.load mm_second
    mop.load matmul
    if SWIGLU {
        // SCALE / Σ score, kept at Dst tile 4 (exp_setup takes l4-l6)
        cb.wait scores
        cb.pop scores
        sfp.li l0, sc[0], fmt=fp32
        for i in 1..SLOTS {
            sfp.li l1, sc[i], fmt=fp32
            sfp.add l0, l0, l1; sfp.nop
        }
        recip_l0!()
        sfp.li l1, SCALE
        sfp.mul l0, l0, l1; sfp.nop
        math.rwc reset
        sfp.store dst[4 * dst.tile], l0, fmt=fp32
    }
    for j in 0..count {
        if SWIGLU {
            if j & 1 {
                math.cfg dst_offset=dst.tile
                repeat face in 4..8 { math.zero face=face, fmt=fp32 }    // faces count from Dst row 0
            } else {
                sem.stall math|sync, ready, notmax
                repeat face in 0..4 { math.zero face=face, fmt=fp32 }
            }
        } else {
            sem.stall math|sync, ready, notmax
            repeat face in 0..4 { math.zero face=face, fmt=fp32 }
        }
        for k in 0..KT * SUMS / SPLIT {
            math.rwc reset
            tensix.stall math, srca_vld|srcb_vld
            mop.run matmul
            math.rwc reset, release=b
        }
        tensix.stall sync, math
        if SWIGLU {
            if j & 1 {
                math.cfg dst_offset=0
                pr = first_col + (j / 2) * COLW
                exp_setup!()
                math.rwc reset
                sfp.load l0, dst[4 * dst.tile], fmt=fp32
                sfp.li l7, sc[pr / INTER_T], fmt=fp32
                sfp.mul l7, l7, l0; sfp.nop
                swiglu_step!()                        // rows 0..3, even then odd columns: outputs 0..15
                swiglu_step!()
                math.rwc dst+=12
                swiglu_step!()                        // rows 16..19: outputs 16..31
                swiglu_step!()
                math.rwc reset
                tensix.stall sync, math|sfpu
                sem.inc ready
            }
        } else { sem.inc ready }
    }
}

fn trisc2() {
    if OUT32 { pack.fmt in=fp32, out=fp32 } else { pack.fmt in=fp32, out=bf16 }
    for j in 0..count / (1 + SWIGLU) {
        sem.stall tdma|pack|sync, ready, nonzero
        p = cb.reserve results
        pack.move p, dst[0]
        tensix.stall sync, pack0
        tensix.wait
        cb.push results
        sem.dec ready
    }
}

fn ncrisc() {
    if WAIT {
        loop {
            noc.read flags, flag[0], n=WAIT * 16, wait
            ok = 1
            for c in 0..WAIT { if flags[c * 16] != token { ok = 0 } }
            if ok { break }
            for i in 0..POLL_BACKOFF { fence }  // spare the flag's DRAM bank and the producer's reads
        }
    }
    a = cb.reserve activations
    if X2 {
        t = noc.group read
        for g in xg_lo..xg_hi {
            noc.read a + g * K, x[g * XROW], n=K / 2, tid=t
            noc.read a + g * K + K / 2, x2[g * X2ROW], n=K / 2, tid=t
        }
        noc.wait t
    } else {
        if XSEG {
            t = noc.read a, x[0], n=XS
            noc.read a + XS, x[XROW], n=XS, tid=t
            noc.read a + 2 * XS, x[2 * XROW], n=XS, tid=t
            noc.wait t
        } else { noc.read a, x[row * X_STRIDE], n=SUMS * XS, wait }
    }
    cb.push activations
    for j in 0..count / (1 + SWIGLU) {
        p = cb.wait results
        if OUT32 {
            l1.copy_words line, p, n=16
            l1.copy_words line + 16, p + 256, n=16
        } else {
            l1.copy_words line, p, n=8
            l1.copy_words line + 16, p + 256, n=8
        }
        col = (first_col + j * col_step) * 32
        if PACK_OUT {
            // Column tile c: its low 16 values at (c / 16) * 512 + (c % 16) * 16, the high 16 256 later.
            c = col / 32
            lo = (c & 15) * 16
            l1.copy_words packed + lo, line, n=8
            l1.copy_words packed + lo + 256, line + 16, n=8
            o = row * OUT_STRIDE + part * SPLIT_STRIDE + (c / 16) * 512 + lo
            w = noc.write output[o], packed + lo, n=16
            noc.write output[o + 256], packed + lo + 256, n=16, tid=w
            noc.wait w
        } else {
            if SEG1 {
                if col < SEG1 * 32 { noc.write output[col], line, n=32, wait }
                else {
                    if col < SEG2 * 32 { noc.write output2[col - SEG1 * 32], line, n=32, wait }
                    else { noc.write output3[col - SEG2 * 32], line, n=32, wait }
                }
            } else { noc.write output[row * OUT_STRIDE + part * SPLIT_STRIDE + col], line, n=32, wait }
        }
        cb.pop results
    }
}
