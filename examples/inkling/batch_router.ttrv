// router.ttrv over ROWS rows with WORKERS workers, each taking rows in turn.
//
// Inkling MoE routing (reference.moe): s = sigmoid(logits); the top TOP experts by s + bias, all on the SFPU.
// Writes select[k] = FP32 id + 2^23 (its low bits are the integer id; experts.ttrv masks them) in descending s + bias,
// and score[k] = that expert's s. The SwiGLU kernel turns the scores into weights s / Σ s * route_scale.
//
// One worker. Dst tiles: 0 s, 1 v = s + bias, 2 expert index (index[e] = e), 3 selected ids, 4 selected scores,
// 5 scalars. The EXPERTS = 128 values are rows 0..7: SFPU addresses 0, 2, 4, 6. Each round takes the lane maximum
// of v, the lowest index attaining it, gathers its s and sets its v to -inf. Round k's results go to address 4k
// (element 64k) of tiles 3 and 4.
const EXPERTS = 128
const TOP = 8
const PARTS = 1          // logits arrive as PARTS partial sums (a K-split projection): part s at elements 128 s ..
const ROWS = 1
const WORKERS = 1
grid WORKERS
shared { nrows = (ROWS + WORKERS - 1 - core.id) / WORKERS }

param logits: fp32[]   // [1024], EXPERTS valid (the router projection's FP32 output)
param bias: fp32[]     // [1024], EXPERTS valid
param index: fp32[]    // [1024]: e at element e
param select: fp32[]   // [16]
param score: fp32[]    // [16]

const T_S = 0
const T_V = dst.tile
const T_I = 2 * dst.tile
const T_SEL = 3 * dst.tile
const T_SCORE = 4 * dst.tile
const SCR = 5 * dst.tile
const ADDRS = [0, 2, 4, 6]
const LATER = [2, 4, 6]

cb pages_in: u32[1024], pages=3
cb loaded: u32[16], pages=1
cb results: fp32[1024], pages=2
sem ready = math_pack, max=1
l1 ids: fp32[16]
l1 values: fp32[16]

include math

// l0 = the maximum (MIN = 0) or minimum (MIN = 1) over all 32 lanes, broadcast; clobbers l1-l3, transposes l4-l7.
macro extreme_lanes(MIN) {
    repeat stage in 0..3 {
        sfp.mov l1, l0
        repeat 4 >> stage { sfp.shft2 l1, l1, rotate; sfp.nop }
        if MIN { sfp.minmax l0, l1; sfp.nop } else { sfp.minmax l1, l0; sfp.nop }
    }
    sfp.mov l1, l0
    sfp.mov l2, l0
    sfp.mov l3, l0
    sfp.transp
    if MIN {
        sfp.minmax l0, l1; sfp.nop
        sfp.minmax l0, l2; sfp.nop
        sfp.minmax l0, l3; sfp.nop
    } else {
        sfp.minmax l1, l0; sfp.nop
        sfp.minmax l2, l0; sfp.nop
        sfp.minmax l3, l0; sfp.nop
    }
}

fn brisc() {
  for j in 0..nrows {
    p = cb.reserve pages_in, n=3
    t = noc.read p, logits[(core.id + j * WORKERS) * 1024], n=1024
    noc.read p + 1024, bias[0], n=1024, tid=t
    noc.read p + 2048, index[0], n=1024, tid=t
    noc.wait t
    cb.push pages_in, n=3
  }
}

fn trisc0() {
  for j in 0..nrows {
    p = cb.wait pages_in, n=3
    unpack.dest p, dst[0]
    unpack.dest p + 1024, dst[dst.tile]
    unpack.dest p + 2048, dst[2 * dst.tile]
    cb.pop pages_in, n=3
    cb.reserve loaded
    cb.push loaded
  }
}

fn trisc1() {
    math.fmt dst=fp32, sfp=fp32
    math.cfg dst_offset=0
  for j in 0..nrows {
    math.rwc reset
    cb.wait loaded
    cb.pop loaded
    exp_setup!()
    // Partial s of expert rows 0..7 sits at rows 8 s ..: addresses 8 s + a.
    repeat a in ADDRS {
        sfp.load l0, dst[T_S + a], fmt=fp32
        repeat part in 1..PARTS {
            sfp.load l1, dst[T_S + 8 * part + a], fmt=fp32
            sfp.add l0, l0, l1; sfp.nop
        }
        sfp.store dst[T_S + a], l0, fmt=fp32
    }
    repeat a in ADDRS {
        sfp.load l0, dst[T_S + a], fmt=fp32
        sigmoid_l0!()
        sfp.store dst[T_S + a], l0, fmt=fp32
        sfp.load l1, dst[T_V + a], fmt=fp32
        sfp.add l0, l0, l1; sfp.nop
        sfp.store dst[T_V + a], l0, fmt=fp32
    }
    for k in 0..TOP {
        // m = max v
        sfp.load l0, dst[T_V], fmt=fp32
        repeat a in LATER {
            sfp.load l1, dst[T_V + a], fmt=fp32
            sfp.minmax l1, l0; sfp.nop
        }
        extreme_lanes!(0)
        sfp.store dst[SCR], l0, fmt=fp32
        // sel = the lowest index with v == m
        sfp.li l5, 1e9
        repeat a in ADDRS {
            sfp.load l1, dst[T_V + a], fmt=fp32
            sfp.load l0, dst[SCR], fmt=fp32
            sfp.mad l1, l0, neg_one, l1; sfp.nop
            sfp.li l3, 1e9
            sfp.load l2, dst[T_I + a], fmt=fp32
            sfp.if l1 == 0 { sfp.mov l3, l2 }
            sfp.minmax l5, l3; sfp.nop
        }
        sfp.mov l0, l5
        extreme_lanes!(1)
        sfp.store dst[SCR + 4], l0, fmt=fp32
        // its score; then remove it from v
        sfp.li l6, 0.0
        repeat a in ADDRS {
            sfp.load l1, dst[T_I + a], fmt=fp32
            sfp.load l0, dst[SCR + 4], fmt=fp32
            sfp.mad l1, l0, neg_one, l1; sfp.nop
            sfp.li l3, 0.0
            sfp.load l2, dst[T_S + a], fmt=fp32
            sfp.li l4, -inf
            sfp.if l1 == 0 {
                sfp.mov l3, l2
                sfp.store dst[T_V + a], l4, fmt=fp32
            }
            sfp.add l6, l6, l3; sfp.nop
        }
        sfp.mov l0, l6
        reduce_lanes!()
        sfp.store dst[T_SCORE + 4 * k], l0, fmt=fp32
        sfp.load l0, dst[SCR + 4], fmt=fp32
        sfp.li l1, 8388608.0
        sfp.add l0, l0, l1; sfp.nop
        sfp.store dst[T_SEL + 4 * k], l0, fmt=fp32
    }
    tensix.stall sync, math|sfpu
    sem.inc ready
  }
}

fn trisc2() {
  for j in 0..nrows {
    pack.fmt in=fp32, out=fp32
    sem.stall tdma|pack|sync, ready, nonzero
    p = cb.reserve results, n=2
    pack.move p, dst[T_SEL]
    pack.move p + 1024, dst[T_SCORE]
    tensix.stall sync, pack0
    tensix.wait
    cb.push results, n=2
    sem.dec ready
  }
}

fn ncrisc() {
  for j in 0..nrows {
    row = core.id + j * WORKERS
    r = cb.wait results, n=2
    for k in 0..16 {
        ids[k] = r[64 * (k % TOP)]
        values[k] = r[1024 + 64 * (k % TOP)]
    }
    t = noc.write select[row * 1024], ids, n=16
    noc.write score[row * 1024], values, n=16, tid=t
    noc.wait t
    cb.pop results, n=2
  }
}
