// rmsnorm, one token, one core:  y = x / sqrt(mean(x^2) + eps) * gamma
// x, gamma, y: bf16 vectors of DIM elements in dram, DIM/1024 tiles each (flat order, not tilized).
//
// two versions of the same kernel:
//   rmsnorm       naive: tile pseudo-instructions and plain loops. what you write first.
//   rmsnorm_fast  templates: the same math with a replay + mop + sfpmacro for the two SFPU passes, and
//                 x*gamma on the FPU at full fidelity. modelled on blackhole-py-old/examples/rmsnorm_hybrid.py.

.version 0
.target blackhole
.dst .b32
.include "std.ttptx"

.define TILES   2                  // 1B: 2048 elements. 8B: 4
.define INV_DIM 0.00048828125      // 1 / 2048
.define EPS     0.00001

// ---------------------------------------------------------------------------------------------------------
// naive
// ---------------------------------------------------------------------------------------------------------

.visible .entry rmsnorm (
    .param .dram x,
    .param .dram gamma,
    .param .dram y
) .cores 1
{
    .reg .tile.bf16 %xt<TILES>, %gt<TILES>, %yt<TILES>;
    .reg .dst       %dx<TILES>, %dg<TILES>;
    .reg .v         %acc, %v, %w, %s;
    .reg .u32       %t, %i, %o;

    // dram -> l1 -> srcA -> dst (fp32)
    loop %t = 0, TILES {
        shl.b32   %o, %t, 11;                  // 2048 bytes per bf16 tile
        cp.async  %xt[%t], [x + %o];
        cp.async  %gt[%t], [gamma + %o];
        unpack    %a, %xt[%t];
        mov.tile  %dx[%t], %a;
        unpack    %a, %gt[%t];
        mov.tile  %dg[%t], %a;
    }

    // sum of squares: each lane accumulates TILES * 32 values
    mov.f32 %acc, 0.0;
    loop %t = 0, TILES {
        loop %i = 0, 32 {
            ld.f32   %v, %dx[%t].v[%i];
            fma.f32  %acc, %v, %v, %acc;
        }
    }
    call (%s), hsum, (%acc);
    mul.f32  %s, %s, INV_DIM;
    add.f32  %s, %s, EPS;
    call (%s), rsqrt, (%s);

    // y = x * s * gamma, pack, write
    loop %t = 0, TILES {
        loop %i = 0, 32 {
            ld.f32   %v, %dx[%t].v[%i];
            ld.f32   %w, %dg[%t].v[%i];
            mul.f32  %v, %v, %s;
            mul.f32  %v, %v, %w;
            st.f32   %dx[%t].v[%i], %v;
        }
        pack.rn   %yt[%t], %dx[%t];
        shl.b32   %o, %t, 11;
        cp.async  [y + %o], %yt[%t];
    }
    exit;
}

// ---------------------------------------------------------------------------------------------------------
// with templates
// ---------------------------------------------------------------------------------------------------------

.visible .entry rmsnorm_fast (
    .param .dram x,
    .param .dram gamma,
    .param .dram y
) .cores 1
{
    .reg .tile.bf16 %xt<TILES>, %gt<TILES>, %yt<TILES>;
    .reg .dst       %dp<TILES>, %ds;           // products x*gamma; scratch copy of x for the squares
    .reg .v         %x0, %x1, %x2, %x3, %s;
    .reg .u32       %t, %o;

    // square-accumulate, 1 SFPU instruction per vector. MAD latency is 2, so two independent chains:
    // x0 <-> x2 and x1 <-> x3. each macro squares what it loaded and adds the other chain's last result.
    // x2 / x3 start at 0 and hold the two partial sums at the end.
    .sfpmacro sq02 { @0 fma.f32 %x, %x, %x, %x2 }      // %x in A: always invoked with target %x0
    .sfpmacro sq13 { @0 fma.f32 %x, %x, %x, %x3 }      //                                  %x1
    .sfpmacro sq20 { @0 fma.f32 %x, %x, %x, %x0 }      //                                  %x2
    .sfpmacro sq31 { @0 fma.f32 %x, %x, %x, %x1 }      //                                  %x3

    // scale by s and store back: load at t, multiply at t+1, store at t+3 (delays from rmsnorm_hybrid.py).
    // one macro, four rotating targets so a load never clobbers a value that is still waiting to be stored.
    .sfpmacro scale { @0 mul.f32 %x, %s, %x;  @2 st.f32 %x }

    // 4 vectors = 8 dst rows per replay, a mop runs it 8 times = one tile per mop
    .replay sq8 (.dst %d) {
        vmacro.f32  sq02, %x0, %d.v[0];
        vmacro.f32  sq13, %x1, %d.v[1];
        vmacro.f32  sq20, %x2, %d.v[2];
        vmacro.f32  sq31, %x3, %d.v[3]  {d+=8};
    }
    .replay scale8 (.dst %d) {
        vmacro.f32  scale, %x0, %d.v[0];
        vmacro.f32  scale, %x1, %d.v[1];
        vmacro.f32  scale, %x2, %d.v[2];
        vmacro.f32  scale, %x3, %d.v[3]  {d+=8};
    }
    .mop sq_tile loop(outer = 1, inner = 8) (.dst %d) {
        body: replay sq8, %d
    }
    .mop scale_tile loop(outer = 1, inner = 8) (.dst %d) {
        body: replay scale8, %d
    }

    loop %t = 0, TILES {
        shl.b32   %o, %t, 11;
        cp.async  %xt[%t], [x + %o];
        cp.async  %gt[%t], [gamma + %o];
    }

    mov.f32 %x2, 0.0;
    mov.f32 %x3, 0.0;
    loop %t = 0, TILES {
        unpack       %a, %xt[%t];
        unpack       %b, %gt[%t];
        mov.tile     %ds, %a;                  // x as fp32, for the squares
        zero         %dp[%t];
        fma.tile.p4  %dp[%t], %a, %b;          // x * gamma at full bf16 precision (32 ELWMUL)
        mop          sq_tile, %ds;             // x2, x3 += x^2 over the tile
    }

    add.f32  %s, %x2, %x3;
    call (%s), hsum, (%s);
    mul.f32  %s, %s, INV_DIM;
    add.f32  %s, %s, EPS;
    call (%s), rsqrt, (%s);

    loop %t = 0, TILES {
        mop       scale_tile, %dp[%t];
        pack.rn   %yt[%t], %dp[%t];
        shl.b32   %o, %t, 11;
        cp.async  [y + %o], %yt[%t];
    }
    exit;
}

// notes from writing this
//
// - naive: 44 non-blank lines for the whole kernel, all five riscs (plus 40 in std.ttptx, shared). nothing
//   names a risc, a cb, a semaphore, a config register or an address. for comparison, the old
//   kernels.py _rmsnorm and its helpers are 110 lines for the trisc1 part alone, and rmsnorm_hybrid.py is
//   218 lines for the whole kernel.
// - fast: 61 lines. the extra lines are templates, and they need knowledge the naive version doesn't: MAD latency (why
//   two chains), the macro delay numbers, and which operand slot the loaded value goes into. that is the
//   point of making them opt-in.
// - the macro latency numbers (@0 / @2) are copied from a working kernel, not derived. an assembler check
//   that simulates the sub-unit schedule (SFPLOADMACRO.md) would catch wrong delays; that check is worth
//   building before anyone writes a new macro by hand.
// - `shl.b32 %o, %t, 11` before every cp.async is the most repeated line. allowing `[x + %t * 2048]`
//   (reg * imm in an address) would remove it; that's still visible, cheap address math.
// - the 32-vector loops in the naive version lower to runtime vector indexing. the assembler turns
//   "%i steps by 1 in a loop with no other use" into a counter increment; without that rule the naive
//   version would be slow enough that nobody would write it.
